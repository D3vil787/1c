// Серверная логика страницы "Склад-планшет": поиск карточки по штрихкоду и перемещение.

#Область Служебные

Функция ВJSON(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Рез = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Рез;
КонецФункции

Функция Ид(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ОшибкаОтвет(Текст)
	Возврат Новый Структура("ok,error", Ложь, Текст);
КонецФункции

Функция КарточкаПоИд(Ид)
	Попытка
		Ссылка = Справочники.КарточкиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Данные

// Возвращает информацию о карточке и ее текущем месте. Структура с полем ok.
Функция ИнфоОКарточке(Карточка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Карточка", Карточка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Наименование КАК Наименование,
	|	К.ИнвентарныйНомер КАК Инв,
	|	К.СерийныйНомер КАК Серийный,
	|	К.Владелец КАК Номенклатура,
	|	К.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	К.Ссылка = &Карточка";
	Выб = Запрос.Выполнить().Выбрать();
	Если Не Выб.Следующий() Тогда
		Возврат ОшибкаОтвет("Карточка не найдена");
	КонецЕсли;
	Если Выб.ПометкаУдаления Тогда
		Возврат ОшибкаОтвет("Карточка помечена на удаление: " + Выб.Наименование);
	КонецЕсли;

	Инфо = Новый Структура;
	Инфо.Вставить("ok", Истина);
	Инфо.Вставить("id", Ид(Карточка));
	Инфо.Вставить("name", Выб.Наименование);
	Инфо.Вставить("inv", Выб.Инв);
	Инфо.Вставить("serial", Выб.Серийный);
	Инфо.Вставить("item", Выб.Номенклатура);

	// Где числится сейчас.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Карточка", Карточка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Организация КАК Организация,
	|	О.МестоХранения КАК Место,
	|	О.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, Номенклатура = &Карточка) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		Возврат ОшибкаОтвет("Не числится на остатках: " + Выб.Наименование);
	КонецЕсли;
	Если Таблица.Количество() > 1 Тогда
		Возврат ОшибкаОтвет("Числится сразу в нескольких местах, перемещайте через 1С: " + Выб.Наименование);
	КонецЕсли;
	Инфо.Вставить("org", Таблица[0].Организация);
	Инфо.Вставить("place", Таблица[0].Место);

	// Комплекты.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Карточка", Карточка);
	Запрос.УстановитьПараметр("Пустая", Справочники.КарточкиНоменклатуры.ПустаяСсылка());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Комплект КАК Комплект
	|ИЗ
	|	РегистрНакопления.Комплектация.Остатки(, Номенклатура = &Карточка) КАК К
	|ГДЕ
	|	К.КоличествоОстаток > 0
	|	И К.Комплект <> &Пустая
	|	И К.Комплект <> &Карточка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Комплект
	|ИЗ
	|	РегистрНакопления.Комплектация.Остатки(, Комплект = &Карточка) КАК К
	|ГДЕ
	|	К.КоличествоОстаток > 0
	|	И К.Номенклатура <> &Карточка";
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат ОшибкаОтвет("Входит в комплект / является комплектом, перемещайте через 1С: " + Выб.Наименование);
	КонецЕсли;

	Возврат Инфо;

КонецФункции

#КонецОбласти

#Область Действия

// Инициализация страницы: техники и места хранения.
Функция Инициализация() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Структура;
	Рез.Вставить("ok", Истина);

	// Техники: действующие пользователи, которые создавали перемещения за последние 2 года,
	// а также пользователи, чье имя совпадает с сотрудником из регистра ответственных IT-отдела.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", ДобавитьМесяц(ТекущаяДата(), -24));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Пользователь,
	|	П.Наименование КАК Имя
	|ИЗ
	|	Справочник.Пользователи КАК П
	|ГДЕ
	|	НЕ П.ПометкаУдаления
	|	И НЕ П.Недействителен
	|	И НЕ П.Служебный
	|	И (П.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Д.Автор
	|			ИЗ
	|				Документ.Перемещение КАК Д
	|			ГДЕ
	|				Д.Дата >= &Начало)
	|		ИЛИ П.Наименование В
	|			(ВЫБРАТЬ
	|				Р.Сотрудник.Наименование
	|			ИЗ
	|				РегистрСведений.ОтветственныеСотрудникиИТОтдела КАК Р))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	Техники = Новый Массив;
	ПоУмолчанию = "";
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Техники.Добавить(Новый Структура("id,name", Ид(Выб.Пользователь), Выб.Имя));
		Если Выб.Имя = "Репин Артем" Тогда
			ПоУмолчанию = Ид(Выб.Пользователь);
		КонецЕсли;
	КонецЦикла;
	Если ПоУмолчанию = "" И Техники.Количество() > 0 Тогда
		ПоУмолчанию = Техники[0].id;
	КонецЕсли;
	Рез.Вставить("techs", Техники);
	Рез.Вставить("defaultTech", ПоУмолчанию);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	М.Ссылка КАК Ссылка,
	|	М.Наименование КАК Имя
	|ИЗ
	|	Справочник.МестаХранения КАК М
	|ГДЕ
	|	НЕ М.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Имя";
	Места = Новый Массив;
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Места.Добавить(Новый Структура("id,name", Ид(Выб.Ссылка), Выб.Имя));
	КонецЦикла;
	Рез.Вставить("places", Места);
	Принтеры = Новый Массив;
	Для Каждого Принтер Из СписокПринтеров() Цикл
		Принтеры.Добавить(Новый Структура("id,name", Принтер.id, Принтер.name));
	КонецЦикла;
	Рез.Вставить("printers", Принтеры);

	Возврат ВJSON(Рез);

КонецФункции

// Карточки по серийному или инвентарному номеру (точное совпадение, без учета регистра).
Функция КарточкиПоНомеру(Номер)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", Номер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И (К.СерийныйНомер = &Номер
	|		ИЛИ К.ИнвентарныйНомер = &Номер)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Список для выбора, когда номеру соответствует несколько карточек.
Функция СписокВыбораКарточек(Карточки)
	Места = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Карточки", Карточки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	О.Номенклатура КАК Карточка,
	|	О.МестоХранения КАК Место
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, Номенклатура В (&Карточки)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Места.Вставить(Выб.Карточка, Строка(Выб.Место));
	КонецЦикла;
	Инфо = ИнфоКарточек(Карточки);
	Список = Новый Массив;
	Для Каждого Карт Из Карточки Цикл
		Св = Инфо.Получить(Карт);
		Если Св = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Место = Места.Получить(Карт);
		Список.Добавить(Новый Структура("id,name,inv,serial,place", Ид(Карт), Св.Имя, Св.Инв, Св.Серийный, ?(Место = Неопределено, "не числится на остатках", Место)));
	КонецЦикла;
	Возврат Список;
КонецФункции

// Что отсканировали: карточка по ее id (после выбора из списка), штрихкод или серийный/инвентарный номер.
// Возвращает структуру: Объект (карточка или номенклатура) либо Ответ (готовая структура ошибки/выбора).
Функция ОбъектПоСкану(Данные)
	Рез = Новый Структура("Объект,Ответ", Неопределено, Неопределено);
	ИдКарточки = Данные.Получить("card");
	Если ИдКарточки <> Неопределено Тогда
		Карт = КарточкаПоИд(Строка(ИдКарточки));
		Если Карт = Неопределено Тогда
			Рез.Ответ = ОшибкаОтвет("Карточка не найдена");
		Иначе
			Рез.Объект = Карт;
		КонецЕсли;
		Возврат Рез;
	КонецЕсли;
	Штрихкод = СокрЛП(Строка(Данные.Получить("barcode")));
	Если Штрихкод = "" Тогда
		Рез.Ответ = ОшибкаОтвет("Пустой штрихкод");
		Возврат Рез;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ш.Номенклатура КАК Объект
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ
	|	Ш.Штрихкод = &Штрихкод";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Рез.Объект = Выб.Объект;
		Возврат Рез;
	КонецЕсли;

	Карточки = КарточкиПоНомеру(Штрихкод);
	Если Карточки.Количество() = 0 Тогда
		Рез.Ответ = ОшибкаОтвет("Не найдено (ни штрихкод, ни серийный/инвентарный номер): " + Штрихкод);
	ИначеЕсли Карточки.Количество() = 1 Тогда
		Рез.Объект = Карточки[0];
	Иначе
		Рез.Ответ = Новый Структура("ok,multi,list,error", Ложь, Истина, СписокВыбораКарточек(Карточки), "Найдено несколько карточек с номером " + Штрихкод);
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Поиск карточки по штрихкоду.
Функция Скан(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);
	Разбор = ОбъектПоСкану(Данные);
	Если Разбор.Ответ <> Неопределено Тогда
		Возврат ВJSON(Разбор.Ответ);
	КонецЕсли;
	Объект = Разбор.Объект;
	Если ТипЗнч(Объект) <> Тип("СправочникСсылка.КарточкиНоменклатуры") Тогда
		Возврат ВJSON(ОшибкаОтвет("Это номенклатура без карточки (" + Объект + "), перемещайте через 1С"));
	КонецЕсли;

	Инфо = ИнфоОКарточке(Объект);
	Если Инфо.ok Тогда
		Инфо.Вставить("place", Строка(Инфо.place));
		Инфо.Удалить("org");
		Инфо.Удалить("item");
	Иначе
		// Карточку нашли, но переместить нельзя: страница все равно может предложить напечатать штрихкод.
		Инфо.Вставить("cardId", Ид(Объект));
		Инфо.Вставить("cardName", Строка(Объект));
	КонецЕсли;
	Возврат ВJSON(Инфо);

КонецФункции

// Создание и проведение перемещений.
Функция Переместить(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);

	Попытка
		Техник = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("tech")));
		МестоПрихода = Справочники.МестаХранения.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("dest")));
		ИмяТехника = Строка(Техник);
		ИмяМеста = Строка(МестоПрихода);
	Исключение
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник или место назначения"));
	КонецПопытки;
	Если ИмяТехника = "" Или ИмяМеста = "" Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник или место назначения"));
	КонецЕсли;
	Список = Данные.Получить("cards");
	Если Список = Неопределено Или Список.Количество() = 0 Тогда
		Возврат ВJSON(ОшибкаОтвет("Нет отсканированных позиций"));
	КонецЕсли;

	// Группировка по (организация, место-источник).
	Группы = Новый Соответствие;
	Ошибки = Новый Массив;
	Для Каждого ИдКарточки Из Список Цикл
		Карточка = КарточкаПоИд(ИдКарточки);
		Если Карточка = Неопределено Тогда
			Ошибки.Добавить("Карточка не найдена");
			Продолжить;
		КонецЕсли;
		Инфо = ИнфоОКарточке(Карточка);
		Если Не Инфо.ok Тогда
			Ошибки.Добавить(Инфо.error);
			Продолжить;
		КонецЕсли;
		Если Инфо.place = МестоПрихода Тогда
			Ошибки.Добавить("Уже на месте «" + ИмяМеста + "»: " + Инфо.name);
			Продолжить;
		КонецЕсли;
		Ключ = Ид(Инфо.org) + "|" + Ид(Инфо.place);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Организация,МестоРасхода,Карточки", Инфо.org, Инфо.place, Новый Массив);
			Группы.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Карточки.Добавить(Новый Структура("Карточка,Номенклатура,Имя", Карточка, Инфо.item, Инфо.name));
	КонецЦикла;

	Создано = Новый Массив;
	КоличествоПеремещено = 0;

	Для Каждого КЗ Из Группы Цикл
		Группа = КЗ.Значение;
		Попытка
			Документ = Документы.Перемещение.СоздатьДокумент();
			Документ.Дата = ТекущаяДата();
			Документ.ОрганизацияРасхода = Группа.Организация;
			Документ.ОрганизацияПрихода = Группа.Организация;
			Документ.МестоХраненияРасхода = Группа.МестоРасхода;
			Документ.МестоХраненияПрихода = МестоПрихода;
			Документ.Автор = Техник;
			Документ.ДатаСоздания = ТекущаяДата();
			Документ.Комментарий = "Создано со склада (планшет). Техник: " + ИмяТехника;
			Для Каждого Поз Из Группа.Карточки Цикл
				НовСтр = Документ.Номенклатура.Добавить();
				НовСтр.Номенклатура = Поз.Номенклатура;
				НовСтр.КарточкаНоменклатуры = Поз.Карточка;
				НовСтр.ЕдиницаИзмерения = Поз.Номенклатура.ЕдиницаИзмерения;
				НовСтр.Количество = 1;
			КонецЦикла;
			ТекстСообщений();
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			Создано.Добавить("№ " + Документ.Номер + " (" + Строка(Группа.МестоРасхода) + ", " + Группа.Карточки.Количество() + " шт.)");
			КоличествоПеремещено = КоличествоПеремещено + Группа.Карточки.Количество();
		Исключение
			Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Текст = Текст + " " + ТекстСообщений();
			Ошибки.Добавить("Не удалось провести перемещение из «" + Строка(Группа.МестоРасхода) + "»: " + Текст);
		КонецПопытки;
	КонецЦикла;

	Рез = Новый Структура;
	Если Ошибки.Количество() = 0 Тогда
		Рез.Вставить("ok", Истина);
		Рез.Вставить("text", "перемещено " + КоличествоПеремещено + " поз. в «" + ИмяМеста + "». Документы: " + СтрСоединить(Создано, "; "));
	ИначеЕсли Создано.Количество() > 0 Тогда
		Рез.Вставить("ok", Истина);
		Рез.Вставить("text", "перемещено " + КоличествоПеремещено + " поз. Документы: " + СтрСоединить(Создано, "; ") + ". ПРОПУЩЕНО: " + СтрСоединить(Ошибки, " | "));
	Иначе
		Рез.Вставить("ok", Ложь);
		Рез.Вставить("error", СтрСоединить(Ошибки, " | "));
	КонецЕсли;
	Возврат ВJSON(Рез);

КонецФункции

Функция ТекстСообщений()
	Результат = "";
	Попытка
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Результат = Результат + " " + Сообщение.Текст;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат СокрЛП(Результат);
КонецФункции

#КонецОбласти

#Область Инвентаризация

Функция МестоПоИд(Ид)
	Попытка
		Ссылка = Справочники.МестаХранения.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ОрганизацияИнвентаризации(Место)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", "%Центр Букетов%");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК О
	|ГДЕ
	|	О.Наименование ПОДОБНО &Имя
	|	И НЕ О.ПометкаУдаления";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Ссылка;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Место", Место);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Организация КАК Ссылка
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, МестоХранения В ИЕРАРХИИ(&Место)) КАК О";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Входит ли место в иерархию Корень (на любой глубине вложенности, включая само Корень).
Функция МестоВнутри(Место, Корень)
	Если Место = Неопределено Или Корень = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Текущее = Место;
	Для Н = 1 По 30 Цикл
		Если Текущее = Корень Тогда
			Возврат Истина;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Текущее) Тогда
			Возврат Ложь;
		КонецЕсли;
		Текущее = Текущее.Родитель;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Строит таблицу учетных остатков штатной функцией документа "Инвентаризация".
Функция ТаблицаУчета(Место, СПодчиненными)
	Организация = ОрганизацияИнвентаризации(Место);
	Если Организация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Документ = Документы.Инвентаризация.СоздатьДокумент();
	Документ.Организация = Организация;
	Документ.МестоХранения = Место;
	Документ.СУчетомПодчиненныхМестХранения = СПодчиненными;
	Таблица = Документы.Инвентаризация.ТаблицаИнвентаризацииПоОстаткам(Документ);
	Возврат Новый Структура("Документ,Таблица", Документ, Таблица);
КонецФункции

Функция ПоКарточкам(Строка)
	Если Не ЗначениеЗаполнено(Строка.КарточкаНоменклатуры) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Строка.КарточкаНоменклатуры <> УправлениеITОтделом8УФПовтИсп.ПолучитьКарточкуНеВедетсяУчетПоКарточкамНоменклатуры(Строка.Номенклатура);
КонецФункции

Функция КлючСтроки(Строка)
	Если ПоКарточкам(Строка) Тогда
		Возврат "c:" + Ид(Строка.КарточкаНоменклатуры);
	КонецЕсли;
	Возврат "i:" + Ид(Строка.Номенклатура) + ":" + Ид(Строка.Партия) + ":" + Ид(Строка.МестоХранения) + ":" + Ид(Строка.Комплект);
КонецФункции

Функция ИнфоКарточек(СписокКарточек)
	Результат = Новый Соответствие;
	Если СписокКарточек.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Список", СписокКарточек);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Имя,
	|	К.ИнвентарныйНомер КАК Инв,
	|	К.СерийныйНомер КАК Серийный,
	|	К.Владелец.Наименование КАК НомИмя
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	К.Ссылка В (&Список)";
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Результат.Вставить(Выб.Ссылка, Новый Структура("Имя,Инв,Серийный,НомИмя", Выб.Имя, Выб.Инв, Выб.Серийный, Выб.НомИмя));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Загрузка учетных остатков места хранения.
Функция ИнвЗагрузить(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);
	Место = МестоПоИд(Данные.Получить("place"));
	Если Место = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбрано место хранения"));
	КонецЕсли;
	СПодчиненными = (Данные.Получить("children") = Истина);

	Учет = ТаблицаУчета(Место, СПодчиненными);
	Если Учет = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не удалось определить организацию"));
	КонецЕсли;
	Таблица = Учет.Таблица;

	Карточки = Новый Массив;
	Для Каждого С Из Таблица Цикл
		Если ПоКарточкам(С) И С.КоличествоУчет > 0 Тогда
			Карточки.Добавить(С.КарточкаНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	Инфо = ИнфоКарточек(Карточки);

	Строки = Новый Массив;
	Для Каждого С Из Таблица Цикл
		Если С.КоличествоУчет <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("key", КлючСтроки(С));
		Стр.Вставить("qty", С.КоличествоУчет);
		Стр.Вставить("unit", Строка(С.ЕдиницаИзмерения));
		Стр.Вставить("place", Строка(С.МестоХранения));
		// Комплектующая: ссылка на карточку комплекта (у самого комплекта и у отдельных предметов пусто).
		// Комплектующая числится в регистре "Остатки" с партией = карточка комплекта (так же работает десктопная форма).
		КомплектСтроки = С.Комплект;
		Если Не ЗначениеЗаполнено(КомплектСтроки)
			И ТипЗнч(С.Партия) = Тип("СправочникСсылка.КарточкиНоменклатуры")
			И ЗначениеЗаполнено(С.Партия)
			И С.Партия <> С.КарточкаНоменклатуры Тогда
			КомплектСтроки = С.Партия;
		КонецЕсли;
		Стр.Вставить("kit", ?(ЗначениеЗаполнено(КомплектСтроки), Ид(КомплектСтроки), ""));
		Стр.Вставить("kitName", ?(ЗначениеЗаполнено(КомплектСтроки), Строка(КомплектСтроки), ""));
		Если ПоКарточкам(С) Тогда
			Инф = Инфо.Получить(С.КарточкаНоменклатуры);
			Стр.Вставить("kind", "card");
			Стр.Вставить("id", Ид(С.КарточкаНоменклатуры));
			Стр.Вставить("name", ?(Инф = Неопределено, Строка(С.КарточкаНоменклатуры), Инф.Имя));
			Стр.Вставить("inv", ?(Инф = Неопределено, "", Инф.Инв));
			Стр.Вставить("serial", ?(Инф = Неопределено, "", Инф.Серийный));
		Иначе
			Стр.Вставить("kind", "item");
			Стр.Вставить("id", Ид(С.Номенклатура));
			Стр.Вставить("name", Строка(С.Номенклатура));
			Стр.Вставить("inv", "");
			Стр.Вставить("serial", "");
		КонецЕсли;
		Строки.Добавить(Стр);
	КонецЦикла;

	Рез = Новый Структура;
	Рез.Вставить("ok", Истина);
	Рез.Вставить("place", Строка(Место));
	Рез.Вставить("rows", Строки);
	Если ЗначениеЗаполнено(Данные.Получить("diag")) Тогда
		Рез.Вставить("dbg", ДиагностикаКомплектов(Таблица, Строка(Данные.Получить("diag"))));
	КонецЕсли;
	Возврат ВJSON(Рез);

КонецФункции

// Диагностика связи комплектующих с комплектом (включается из страницы адресом #diag=ЧастьИмениМеста).
Функция ДиагностикаКомплектов(Таблица, Фильтр)
	Рез = Новый Массив;
	Рез.Добавить("v17 диагностика, фильтр места: " + Фильтр);
	Колонки = Новый Массив;
	Для Каждого К Из Таблица.Колонки Цикл
		Колонки.Добавить(К.Имя);
	КонецЦикла;
	Рез.Добавить("колонки таблицы: " + СтрСоединить(Колонки, ", "));
	Карточки = Новый Массив;
	Н = 0;
	Для Каждого С Из Таблица Цикл
		Если СтрНайти(НРег(Строка(С.МестоХранения)), НРег(Фильтр)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(С.КарточкаНоменклатуры) Тогда
			Карточки.Добавить(С.КарточкаНоменклатуры);
		КонецЕсли;
		Н = Н + 1;
		Если Н <= 25 Тогда
			Рез.Добавить("стр: ном=" + Строка(С.Номенклатура) + " | карт=" + Строка(С.КарточкаНоменклатуры) + " | компл=" + Строка(С.Комплект) + " | партия=" + Строка(С.Партия) + " [" + ТипЗнч(С.Партия) + "] | учет=" + С.КоличествоУчет);
		КонецЕсли;
	КонецЦикла;
	Рез.Добавить("строк по месту: " + Н + ", карточек: " + Карточки.Количество());
	Попытка
		МДР = Метаданные.РегистрыНакопления.Комплектация;
		Список = Новый Массив;
		Для Каждого Э Из МДР.Измерения Цикл
			Список.Добавить("изм " + Э.Имя);
		КонецЦикла;
		Для Каждого Э Из МДР.Ресурсы Цикл
			Список.Добавить("рес " + Э.Имя);
		КонецЦикла;
		Для Каждого Э Из МДР.Реквизиты Цикл
			Список.Добавить("рекв " + Э.Имя);
		КонецЦикла;
		Рез.Добавить("Комплектация: " + СтрСоединить(Список, ", "));
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("К", Карточки);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 40
		|	К.Комплект КАК Комплект,
		|	К.Номенклатура КАК Номенклатура,
		|	К.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.Комплектация.Остатки(, Комплект В (&К) ИЛИ Номенклатура В (&К)) КАК К";
		Выб = Запрос.Выполнить().Выбрать();
		Рез.Добавить("Комплектация.Остатки по карточкам места: " + Выб.Количество());
		Пока Выб.Следующий() Цикл
			Рез.Добавить("рег: компл=" + Строка(Выб.Комплект) + " [" + ТипЗнч(Выб.Комплект) + "] | ном=" + Строка(Выб.Номенклатура) + " [" + ТипЗнч(Выб.Номенклатура) + "] | ост=" + Выб.Остаток);
		КонецЦикла;
	Исключение
		Рез.Добавить("ОШИБКА регистра: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

// Скан штрихкода в режиме инвентаризации: карточка или номенклатура без карточек.
Функция ИнвСкан(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);
	Разбор = ОбъектПоСкану(Данные);
	Если Разбор.Ответ <> Неопределено Тогда
		Возврат ВJSON(Разбор.Ответ);
	КонецЕсли;

	Объект = Разбор.Объект;
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.КарточкиНоменклатуры") Тогда
		Инфо = ИнфоКарточек(ОдинМассив(Объект)).Получить(Объект);
		Если Инфо = Неопределено Тогда
			Возврат ВJSON(ОшибкаОтвет("Карточка не найдена"));
		КонецЕсли;
		Рез = Новый Структура("ok,kind,id,name,inv,serial,place,under", Истина, "card", Ид(Объект), Инфо.Имя, Инфо.Инв, Инфо.Серийный, "", Ложь);
		МестоИнв = Неопределено;
		Если Данные.Получить("place") <> Неопределено Тогда
			МестоИнв = МестоПоИд(Данные.Получить("place"));
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Карточка", Объект);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	О.МестоХранения КАК Место
		|ИЗ
		|	РегистрНакопления.Остатки.Остатки(, Номенклатура = &Карточка) КАК О
		|ГДЕ
		|	О.КоличествоОстаток > 0";
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			Рез.place = Строка(Выб.Место);
			// Предмет числится на подчиненном месте выбранного места (например, комплект на рабочем месте под тролем).
			Рез.under = (Выб.Место <> МестоИнв И МестоВнутри(Выб.Место, МестоИнв));
		КонецЕсли;
		Возврат ВJSON(Рез);
	КонецЕсли;

	Рез = Новый Структура("ok,kind,id,name,inv,serial,place", Истина, "item", Ид(Объект), Строка(Объект), "", "", "");
	Возврат ВJSON(Рез);

КонецФункции

Функция ОдинМассив(Значение)
	М = Новый Массив;
	М.Добавить(Значение);
	Возврат М;
КонецФункции

// Создание документа "Инвентаризация" (без проведения).
// Место хранения "Потеряшки" (для недостающих при инвентаризации).
Функция МестоПотеряшки() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 10
	|	М.Ссылка КАК Ссылка,
	|	М.Наименование КАК Имя
	|ИЗ
	|	Справочник.МестаХранения КАК М
	|ГДЕ
	|	НЕ М.ПометкаУдаления
	|	И М.Наименование ПОДОБНО ""%отеряшк%""";
	Выб = Запрос.Выполнить().Выбрать();
	Лучшее = Неопределено;
	ДлинаЛучшего = 0;
	Пока Выб.Следующий() Цикл
		Если Лучшее = Неопределено Или СтрДлина(Выб.Имя) < ДлинаЛучшего Тогда
			Лучшее = Выб.Ссылка;
			ДлинаЛучшего = СтрДлина(Выб.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшее;
КонецФункции

Функция ИнвСохранить(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);

	Место = МестоПоИд(Данные.Получить("place"));
	Если Место = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбрано место хранения"));
	КонецЕсли;
	Попытка
		Техник = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("tech")));
		ИмяТехника = Строка(Техник);
	Исключение
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник"));
	КонецПопытки;
	Если ИмяТехника = "" Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник"));
	КонецЕсли;
	СПодчиненными = (Данные.Получить("children") = Истина);
	НаПотеряшки = (Данные.Получить("lost") = Истина);
	МестоПотерь = Неопределено;
	Если НаПотеряшки Тогда
		МестоПотерь = МестоПотеряшки();
		Если МестоПотерь = Неопределено Тогда
			Возврат ВJSON(ОшибкаОтвет("Не найдено место хранения «Потеряшки». Создайте его или снимите галку «Недостающие на Потеряшки»"));
		КонецЕсли;
	КонецЕсли;

	Факты = Новый Соответствие;
	СписокСтрок = Данные.Получить("rows");
	Если СписокСтрок <> Неопределено Тогда
		Для Каждого Эл Из СписокСтрок Цикл
			Факты.Вставить(Эл.Получить("key"), Эл.Получить("fact"));
		КонецЦикла;
	КонецЕсли;

	Учет = ТаблицаУчета(Место, СПодчиненными);
	Если Учет = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не удалось определить организацию"));
	КонецЕсли;
	Документ = Учет.Документ;
	Таблица = Учет.Таблица;

	КлючиУчета = Новый Соответствие;
	НеНайдено = 0;
	Найдено = 0;
	БезПересчета = 0;
	ИдыПотерь = Новый Массив;

	Для Каждого С Из Таблица Цикл
		Если С.КоличествоУчет <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючСтроки(С);
		КлючиУчета.Вставить(Ключ, Истина);
		Факт = Факты.Получить(Ключ);
		Если ПоКарточкам(С) Тогда
			Количество = ?(Факт = Неопределено, 0, Макс(0, Мин(1, Факт)));
			Если Количество = 0 Тогда
				НеНайдено = НеНайдено + 1;
			Иначе
				Найдено = Найдено + 1;
			КонецЕсли;
		Иначе
			Если Факт = Неопределено Тогда
				БезПересчета = БезПересчета + 1;
				Продолжить;
			КонецЕсли;
			Количество = Макс(0, Факт);
		КонецЕсли;
		НовСтр = Документ.Номенклатура.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, С);
		НовСтр.Количество = Количество;
		НовСтр.Сумма = Количество * С.Цена;
		НовСтр.Отклонение = Количество - С.КоличествоУчет;
		// Недостающая карточка: запомним, потом переместим на "Потеряшки" отдельным документом.
		Если НаПотеряшки И Количество = 0 И ПоКарточкам(С) И С.МестоХранения <> МестоПотерь Тогда
			ИдыПотерь.Добавить(Ид(С.КарточкаНоменклатуры));
		КонецЕсли;
	КонецЦикла;

	// Излишки: то, что отсканировано, но по учету на этом месте не числится.
	Лишних = 0;
	Пропущено = Новый Массив;
	СписокЛишних = Данные.Получить("extras");
	Если СписокЛишних <> Неопределено Тогда
		Для Каждого Эл Из СписокЛишних Цикл
			Вид = Эл.Получить("kind");
			Попытка
				Если Вид = "card" Тогда
					Карточка = Справочники.КарточкиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Эл.Получить("id")));
					Владелец = Карточка.Владелец;
					Если КлючиУчета.Получить("c:" + Ид(Карточка)) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					НовСтр = Документ.Номенклатура.Добавить();
					НовСтр.Номенклатура = Владелец;
					НовСтр.КарточкаНоменклатуры = Карточка;
					НовСтр.ЕдиницаИзмерения = Владелец.ЕдиницаИзмерения;
					НовСтр.МестоХранения = Место;
					НовСтр.КоличествоУчет = 0;
					НовСтр.Количество = 1;
					НовСтр.Отклонение = 1;
					Лишних = Лишних + 1;
				Иначе
					Позиция = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Эл.Получить("id")));
					Количество = Макс(0, Эл.Получить("fact"));
					НовСтр = Документ.Номенклатура.Добавить();
					НовСтр.Номенклатура = Позиция;
					НовСтр.КарточкаНоменклатуры = УправлениеITОтделом8УФПовтИсп.ПолучитьКарточкуНеВедетсяУчетПоКарточкамНоменклатуры(Позиция);
					НовСтр.ЕдиницаИзмерения = Позиция.ЕдиницаИзмерения;
					НовСтр.МестоХранения = Место;
					НовСтр.КоличествоУчет = 0;
					НовСтр.Количество = Количество;
					НовСтр.Отклонение = Количество;
					Лишних = Лишних + 1;
				КонецЕсли;
			Исключение
				Пропущено.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	ПустоеМесто = (Документ.Номенклатура.Количество() = 0);
	Если ПустоеМесто И Данные.Получить("empty") <> Истина Тогда
		Рез = Новый Структура("ok,empty,error", Ложь, Истина,
			"На месте нет учётных предметов и ничего не отсканировано. Сохранить инвентаризацию пустого места?");
		Возврат ВJSON(Рез);
	КонецЕсли;

	Документ.Дата = ТекущаяДата();
	Документ.Автор = Техник;
	Документ.ДатаСоздания = ТекущаяДата();
	Документ.Комментарий = "Инвентаризация со склада (планшет). Техник: " + ИмяТехника;
	Документ.ОтветственныйСотрудникИТОтдела = СотрудникПоИмени(ИмяТехника);
	Попытка
		Документ.ОтветственныйСотрудник = Место.ПоследнийОтветственный;
	Исключение
	КонецПопытки;

	Попытка
		ТекстСообщений();
		Документ.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ТекстСообщений();
		Возврат ВJSON(ОшибкаОтвет("Не удалось сохранить инвентаризацию: " + Текст));
	КонецПопытки;

	Текст = "документ № " + Документ.Номер + " сохранён (не проведён). Найдено: " + Найдено
		+ ", не найдено: " + НеНайдено + ", лишних: " + Лишних;
	Если ПустоеМесто Тогда
		Текст = "документ № " + Документ.Номер + " сохранён (не проведён): место пустое, строк нет";
	КонецЕсли;
	Если ИдыПотерь.Количество() > 0 Тогда
		ПарамПеремещения = Новый Структура("tech,dest,cards", Данные.Получить("tech"), Ид(МестоПотерь), ИдыПотерь);
		ОтветПеремещения = ИзJSON(Переместить(ВJSON(ПарамПеремещения)));
		Если ОтветПеремещения.Получить("ok") = Истина Тогда
			Текст = Текст + ". Недостающие: " + ОтветПеремещения.Получить("text");
		Иначе
			Текст = Текст + ". НЕ УДАЛОСЬ переместить недостающие на «" + Строка(МестоПотерь) + "»: " + ОтветПеремещения.Получить("error");
		КонецЕсли;
	КонецЕсли;
	Если БезПересчета > 0 Тогда
		Текст = Текст + ", позиций без карточек не пересчитано (в документ не вошли): " + БезПересчета;
	КонецЕсли;
	Если Пропущено.Количество() > 0 Тогда
		Текст = Текст + ". Не добавлено: " + СтрСоединить(Пропущено, "; ");
	КонецЕсли;
	Рез = Новый Структура("ok,text,number", Истина, Текст, Документ.Номер);
	Возврат ВJSON(Рез);

КонецФункции

Функция СотрудникПоИмени(Имя)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	С.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК С
	|ГДЕ
	|	С.Наименование = &Имя
	|	И НЕ С.ПометкаУдаления
	|	И С.Актуальность";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Ссылка;
	КонецЕсли;
	Возврат Справочники.Сотрудники.ПустаяСсылка();
КонецФункции

#КонецОбласти

#Область Добавление

// Принтеры этикеток (общий доступ Windows). Формат: "Название=\\сервер\принтер", по одному в строке.
Функция СписокПринтеров() Экспорт
	Текст = "";
	// ПРИНТЕРЫ-НАЧАЛО
	Текст = Текст + "Принтер этикеток 1=\\printserver\Zebra_1" + Символы.ПС;
	Текст = Текст + "Принтер этикеток 2=\\printserver\Zebra_2" + Символы.ПС;
	// ПРИНТЕРЫ-КОНЕЦ
	Результат = Новый Массив;
	Номер = 0;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Поз = СтрНайти(Стр, "=");
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("id,name,path", XMLСтрока(Номер), СокрЛП(Лев(Стр, Поз - 1)), СокрЛП(Сред(Стр, Поз + 1))));
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭкранироватьLike(Текст)
	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Спец Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Спец, "~" + Спец);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Поиск номенклатуры по любому тексту в наименовании (все слова должны встречаться).
Функция ПоискНоменклатуры(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);
	Слова = СтрРазделить(СокрЛП(Строка(Данные.Получить("q"))), " ", Ложь);
	Если Слова.Количество() = 0 Тогда
		Возврат ВJSON(Новый Структура("ok,items", Истина, Новый Массив));
	КонецЕсли;

	Запрос = Новый Запрос;
	Условие = "";
	НомерСлова = 0;
	Для Каждого Слово Из Слова Цикл
		НомерСлова = НомерСлова + 1;
		Если НомерСлова > 6 Тогда
			Прервать;
		КонецЕсли;
		Имя = "Слово" + НомерСлова;
		Запрос.УстановитьПараметр(Имя, "%" + ЭкранироватьLike(Слово) + "%");
		Условие = Условие + Символы.ПС + "	И Н.Наименование ПОДОБНО &" + Имя + " СПЕЦСИМВОЛ ""~""";
	КонецЦикла;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 41
	|	Н.Ссылка КАК Ссылка,
	|	Н.Наименование КАК Имя,
	|	Н.ВидНоменклатуры.ВестиУчетПоКарточкамНоменклатуры КАК ПоКарточкам
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления" + Условие + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Н.Наименование";
	Элементы = Новый Массив;
	Выб = Запрос.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Элементы.Добавить(Новый Структура("id,name,card", Ид(Выб.Ссылка), Выб.Имя, Выб.ПоКарточкам = Истина));
	КонецЦикла;
	Возврат ВJSON(Новый Структура("ok,items,more", Истина, Элементы, Элементы.Количество() > 40));

КонецФункции

Функция КонтрольнаяЦифраEAN13(Цифры12)
	Сумма = 0;
	Для Н = 1 По 12 Цикл
		Цифра = Число(Сред(Цифры12, Н, 1));
		Сумма = Сумма + Цифра * ?(Н % 2 = 1, 1, 3);
	КонецЦикла;
	Возврат Строка((10 - Сумма % 10) % 10);
КонецФункции

// Следующий штрихкод последовательности 200... (13 цифр). Вызывать внутри транзакции с блокировкой регистра.
Функция СледующийШтрихкод()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(Ш.Штрихкод) КАК Макс
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ
	|	Ш.Штрихкод ПОДОБНО ""200%""
	|	И ДЛИНАСТРОКИ(Ш.Штрихкод) = 13";
	Выб = Запрос.Выполнить().Выбрать();
	Тело = 200000000000;
	Если Выб.Следующий() И Выб.Макс <> Null И ЗначениеЗаполнено(Выб.Макс) Тогда
		Тело = Число(Лев(Выб.Макс, 12));
	КонецЕсли;
	Тело = Тело + 1;
	Цифры = Формат(Тело, "ЧЦ=12; ЧГ=");
	Возврат Цифры + КонтрольнаяЦифраEAN13(Цифры);
КонецФункции

Функция ШтрихкодКарточки(Карточка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Карточка", Карточка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ш.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ
	|	Ш.Номенклатура = &Карточка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛИНАСТРОКИ(Ш.Штрихкод) УБЫВ,
	|	Ш.Штрихкод";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Штрихкод;
	КонецЕсли;
	Возврат "";
КонецФункции

// Образец реквизитов для ввода остатков: последний проведенный документ поступления.
Функция ОбразецПоступления()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Поступление КАК Д
	|ГДЕ
	|	Д.Проведен
	|	И Д.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидДокументаПоступления.ВводОстатков)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Д.Дата УБЫВ";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Создание карточки, присвоение штрихкода и проведение ввода остатков на выбранное место.
Функция ДобавитьПоступление(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);

	Место = МестоПоИд(Данные.Получить("place"));
	Если Место = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбрано место хранения"));
	КонецЕсли;
	Попытка
		Техник = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("tech")));
		ИмяТехника = Строка(Техник);
	Исключение
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник"));
	КонецПопытки;
	Если ИмяТехника = "" Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбран техник"));
	КонецЕсли;
	Серийный = СокрЛП(Строка(Данные.Получить("serial")));
	Если Серийный = "" Тогда
		Возврат ВJSON(ОшибкаОтвет("Введите или отсканируйте серийный номер"));
	КонецЕсли;
	Попытка
		Позиция = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Получить("item")));
		ВидПозиции = Позиция.ВидНоменклатуры;
		ВедетсяУчет = ВидПозиции.ВестиУчетПоКарточкамНоменклатуры;
		ЕдИзм = Позиция.ЕдиницаИзмерения;
	Исключение
		Возврат ВJSON(ОшибкаОтвет("Не выбрана номенклатура"));
	КонецПопытки;
	Если Не ВедетсяУчет Тогда
		Возврат ВJSON(ОшибкаОтвет("По номенклатуре «" + Строка(Позиция) + "» не ведется учет по карточкам, оприходуйте её через 1С"));
	КонецЕсли;
	Организация = ОрганизацияИнвентаризации(Место);
	Если Организация = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не удалось определить организацию"));
	КонецЕсли;
	ОбразецСсылка = ОбразецПоступления();
	Если ОбразецСсылка = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не найден образец документа ввода остатков для заполнения валюты и налогообложения"));
	КонецЕсли;
	Образец = ОбразецСсылка.ПолучитьОбъект();
	СтавкаНДС = Неопределено;
	Если Образец.Номенклатура.Количество() > 0 Тогда
		СтавкаНДС = Образец.Номенклатура[0].СтавкаНДС;
	КонецЕсли;

	ТекстСообщений();
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("РегистрСведений.ШтрихкодыНоменклатуры").Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		Карточка = Справочники.КарточкиНоменклатуры.СоздатьЭлемент();
		Карточка.Владелец = Позиция;
		Карточка.ВидНоменклатуры = ВидПозиции;
		Карточка.ВестиУчетПоКарточкамНоменклатуры = Истина;
		Карточка.АвтоНаименование = Истина;
		Карточка.СерийныйНомер = Серийный;
		Карточка.Записать();

		Штрихкод = СледующийШтрихкод();
		Запись = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
		Запись.Штрихкод = Штрихкод;
		Запись.Номенклатура = Карточка.Ссылка;
		Запись.ЕдиницаИзмерения = ЕдИзм;
		Запись.МоментВремени = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Запись.Записать();

		Документ = Документы.Поступление.СоздатьДокумент();
		Документ.Дата = ТекущаяДата();
		Документ.ВидДокумента = Перечисления.ВидДокументаПоступления.ВводОстатков;
		Документ.Организация = Организация;
		Документ.МестоХранения = Место;
		Документ.ВалютаДокумента = Образец.ВалютаДокумента;
		Документ.Курс = Образец.Курс;
		Документ.Кратность = Образец.Кратность;
		Документ.НалогообложениеНДС = Образец.НалогообложениеНДС;
		Документ.Автор = Техник;
		Документ.ДатаСоздания = ТекущаяДата();
		Документ.Комментарий = "Создано со склада (планшет). Техник: " + ИмяТехника;
		НовСтр = Документ.Номенклатура.Добавить();
		НовСтр.Номенклатура = Позиция;
		НовСтр.КарточкаНоменклатуры = Карточка.Ссылка;
		НовСтр.ЕдиницаИзмерения = ЕдИзм;
		НовСтр.Количество = 1;
		Если СтавкаНДС <> Неопределено Тогда
			НовСтр.СтавкаНДС = СтавкаНДС;
		КонецЕсли;
		Документ.Записать(РежимЗаписиДокумента.Проведение);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = ТекстСообщений();
		Если Сообщения <> "" Тогда
			Текст = Текст + " " + Сообщения;
		КонецЕсли;
		Возврат ВJSON(ОшибкаОтвет("Не удалось оприходовать: " + Текст));
	КонецПопытки;

	Рез = Новый Структура;
	Рез.Вставить("ok", Истина);
	Рез.Вставить("id", Ид(Карточка.Ссылка));
	Рез.Вставить("name", Карточка.Наименование);
	Рез.Вставить("serial", Серийный);
	Рез.Вставить("barcode", Штрихкод);
	Рез.Вставить("number", Документ.Номер);
	Рез.Вставить("text", "оприходовано: " + Карточка.Наименование + ", штрихкод " + Штрихкод + ", «Ввод остатков» № " + Документ.Номер + " на «" + Строка(Место) + "»");
	Возврат ВJSON(Рез);

КонецФункции

// Текст этикетки 43x25 мм (344x200 точек, 203 dpi) на языке ZPL: наименование номенклатуры, серийный номер, штрихкод.
Функция ТекстЗПЛ(Имя, Серийный, Штрихкод, Формат = "") Экспорт
	Имя = СтрЗаменить(СтрЗаменить(СтрЗаменить(Имя, "^", " "), "~", " "), "\", "/");
	Серийный = СтрЗаменить(СтрЗаменить(СтрЗаменить(Серийный, "^", " "), "~", " "), "\", "/");
	Если СтрДлина(Имя) > 50 Тогда
		Имя = Лев(Имя, 50);
	КонецЕсли;
	ЭтоEAN = (СтрДлина(Штрихкод) = 13);
	Если ЭтоEAN Тогда
		Для Н = 1 По 13 Цикл
			Если СтрНайти("0123456789", Сред(Штрихкод, Н, 1)) = 0 Тогда
				ЭтоEAN = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Текст = "^XA" + Символы.ПС + "^CI28" + Символы.ПС + "^PW344" + Символы.ПС + "^LL200" + Символы.ПС + "^LH0,0" + Символы.ПС;
	Если Формат = "qr" Тогда
		// Слева квадрат 92x92 точки (11,5 мм) только с QR 21x21 модуль (модуль 3 точки = 7,9 мм), отрезается по линиям.
		// Справа наименование, номер штрихкода и серийный номер.
		Штрихкод = СтрЗаменить(Штрихкод, "^", "");
		Текст = Текст + "^FO14,14^BQN,2,3^FDMA," + Штрихкод + "^FS" + Символы.ПС;
		Текст = Текст + "^FO92,0^GB1,93,1^FS" + Символы.ПС;
		Текст = Текст + "^FO0,92^GB93,1,1^FS" + Символы.ПС;
		Текст = Текст + "^FO108,12^FB228,3,0,L,0^A0N,26,24^FD" + Имя + "^FS" + Символы.ПС;
		Текст = Текст + "^FO108,104^A0N,28,26^FD" + Штрихкод + "^FS" + Символы.ПС;
		Если Серийный <> "" Тогда
			Текст = Текст + "^FO108,142^FB228,2,0,L,0^A0N,24,22^FD" + Серийный + "^FS" + Символы.ПС;
		КонецЕсли;
		Текст = Текст + "^XZ" + Символы.ПС;
		Возврат Текст;
	КонецЕсли;
	Текст = Текст + "^FO0,8^FB344,2,0,C,0^A0N,28,26^FD" + Имя + "^FS" + Символы.ПС;
	Если Серийный <> "" Тогда
		Текст = Текст + "^FO0,68^FB344,1,0,C,0^A0N,24,22^FD" + Серийный + "^FS" + Символы.ПС;
	КонецЕсли;
	Если ЭтоEAN Тогда
		Текст = Текст + "^FO30,100^BY3^BEN,62,Y,N^FD" + Штрихкод + "^FS" + Символы.ПС;
	Иначе
		Текст = Текст + "^FO20,100^BY2^BCN,62,Y,N,N^FD" + Штрихкод + "^FS" + Символы.ПС;
	КонецЕсли;
	Текст = Текст + "^XZ" + Символы.ПС;
	Возврат Текст;
КонецФункции

// Отправка ZPL на принтер, открытый общим доступом (\\сервер\принтер).
Функция ОтправитьНаПринтер(ПутьПринтера, ТекстЗадания) Экспорт
	Файл = ПолучитьИмяВременногоФайла("zpl");
	Двоичные = ПолучитьДвоичныеДанныеИзСтроки(ТекстЗадания, КодировкаТекста.UTF8, Ложь);
	Двоичные.Записать(Файл);
	Попытка
		Оболочка = Новый COMОбъект("WScript.Shell");
		Код = Оболочка.Run("cmd /c copy /b """ + Файл + """ """ + ПутьПринтера + """ >nul 2>&1", 0, Истина);
	Исключение
		Описание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Попытка
			УдалитьФайлы(Файл);
		Исключение
		КонецПопытки;
		Возврат "не удалось запустить отправку: " + Описание;
	КонецПопытки;
	Попытка
		УдалитьФайлы(Файл);
	Исключение
	КонецПопытки;
	Если Код <> 0 Тогда
		Возврат "принтер недоступен или нет прав (" + ПутьПринтера + ", код " + Код + ")";
	КонецЕсли;
	Возврат "";
КонецФункции

// Печать штрихкода карточки на выбранный принтер.
Функция ПечатьШтрихкода(ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Данные = ИзJSON(ТелоЗапроса);
	Принтер = Неопределено;
	ИдПринтера = Строка(Данные.Получить("printer"));
	Для Каждого Эл Из СписокПринтеров() Цикл
		Если Эл.id = ИдПринтера Тогда
			Принтер = Эл;
		КонецЕсли;
	КонецЦикла;
	Если Принтер = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Не выбран принтер"));
	КонецЕсли;
	Карточка = КарточкаПоИд(Данные.Получить("card"));
	Если Карточка = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Карточка не найдена"));
	КонецЕсли;
	Инфо = ИнфоКарточек(ОдинМассив(Карточка)).Получить(Карточка);
	Если Инфо = Неопределено Тогда
		Возврат ВJSON(ОшибкаОтвет("Карточка не найдена"));
	КонецЕсли;
	Штрихкод = ШтрихкодКарточки(Карточка);
	Если Штрихкод = "" Тогда
		Возврат ВJSON(ОшибкаОтвет("У карточки нет штрихкода: " + Инфо.Имя));
	КонецЕсли;
	Количество = Данные.Получить("copies");
	Если ТипЗнч(Количество) <> Тип("Число") Или Количество < 1 Тогда
		Количество = 1;
	КонецЕсли;
	Количество = Мин(Количество, 10);
	Задание = "";
	Для Н = 1 По Количество Цикл
		Задание = Задание + ТекстЗПЛ(?(ПустаяСтрока(Инфо.НомИмя), Инфо.Имя, Инфо.НомИмя), Инфо.Серийный, Штрихкод, ?(Данные.Получить("fmt") = "qr", "qr", ""));
	КонецЦикла;
	Ошибка = ОтправитьНаПринтер(Принтер.path, Задание);
	Если Ошибка <> "" Тогда
		Возврат ВJSON(ОшибкаОтвет("Печать: " + Ошибка));
	КонецЕсли;
	Возврат ВJSON(Новый Структура("ok,text", Истина, "отправлено на «" + Принтер.name + "»: " + Штрихкод));

КонецФункции

#КонецОбласти
