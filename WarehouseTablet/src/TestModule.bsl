	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Ссылка КАК Карточка,
	|	К.СерийныйНомер КАК Серийный,
	|	К.ИнвентарныйНомер КАК Инв
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	К.СерийныйНомер <> """"
	|	И НЕ К.ПометкаУдаления
	|	И К.Ссылка В (ВЫБРАТЬ О.Номенклатура ИЗ РегистрНакопления.Остатки.Остатки(, ) КАК О ГДЕ О.КоличествоОстаток > 0)";
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Ш = "";
		ЗапШ = Новый Запрос("ВЫБРАТЬ Ш.Штрихкод КАК Ш ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш ГДЕ Ш.Номенклатура = &К");
		ЗапШ.УстановитьПараметр("К", Выб.Карточка);
		В2 = ЗапШ.Выполнить().Выбрать();
		Если В2.Следующий() Тогда
			Ш = В2.Ш;
		КонецЕсли;
		Рез.Добавить("образец: " + Строка(Выб.Карточка) + " | штрихкод=" + Ш + " | с/н=" + Выб.Серийный + " | инв=" + Выб.Инв);
		Рез.Добавить("1 по штрихкоду:  " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", Ш)))));
		Рез.Добавить("2 по с/н:        " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", Выб.Серийный)))));
		Рез.Добавить("3 по с/н нижним: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", НРег(Выб.Серийный))))));
		Рез.Добавить("4 с пробелами:   " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", "  " + Выб.Серийный + " ")))));
		Если Не ПустаяСтрока(Выб.Инв) Тогда
			Рез.Добавить("5 по инв.номеру: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", Выб.Инв)))));
		КонецЕсли;
		Рез.Добавить("6 по id карточки: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("card", Строка(Выб.Карточка.УникальныйИдентификатор()))))));
		Рез.Добавить("7 инвентаризация, по с/н: " + КоротКо(СкладПланшетСервер.ИнвСкан(ЗапросТело(Новый Структура("barcode", Выб.Серийный)))));
	Иначе
		Рез.Добавить("образец с остатком и серийным не найден");
	КонецЕсли;
	Рез.Добавить("8 несуществующий: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", "ZZZ-НЕТ-ТАКОГО-123")))));
	Рез.Добавить("9 монитор (списан): " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", "3123HLLG502101J")))));
	Рез.Добавить("10 пустой: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", "   ")))));
	// Дубли серийных номеров.
	ЗапД = Новый Запрос;
	ЗапД.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.СерийныйНомер КАК Серийный,
	|	КОЛИЧЕСТВО(*) КАК Кол
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	К.СерийныйНомер <> """"
	|	И НЕ К.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	К.СерийныйНомер
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(*) > 1";
	ВД = ЗапД.Выполнить().Выбрать();
	Если ВД.Следующий() Тогда
		Ответ = СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", ВД.Серийный)));
		Рез.Добавить("11 дубль с/н '" + ВД.Серийный + "' (" + ВД.Кол + " шт.): " + КоротКо(Ответ));
		Разбор = ПрочитатьОтвет(Ответ);
		Если Разбор["multi"] = Истина Тогда
			ПервыйИд = Разбор["list"][0]["id"];
			Рез.Добавить("12 выбор из списка по id: " + КоротКо(СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("card", ПервыйИд)))));
		КонецЕсли;
	Иначе
		Рез.Добавить("11 дублей серийных номеров в базе нет");
	КонецЕсли;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Процедура ОписатьОбъектМД(Рез, ОМД, Заголовок)
	Рез.Добавить("== " + Заголовок);
	Для Каждого Р Из ОМД.Реквизиты Цикл
		Рез.Добавить("  " + Р.Имя + " : " + Строка(Р.Тип));
	КонецЦикла;
	Для Каждого ТЧ Из ОМД.ТабличныеЧасти Цикл
		Рез.Добавить("  ТЧ " + ТЧ.Имя);
		Для Каждого Р Из ТЧ.Реквизиты Цикл
			Рез.Добавить("      " + Р.Имя + " : " + Строка(Р.Тип));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция Разведка5() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	Попытка
		ОписатьОбъектМД(Рез, Метаданные.Справочники.КарточкиНоменклатуры, "Справочник КарточкиНоменклатуры");
		ОписатьОбъектМД(Рез, Метаданные.Справочники.МестаХранения, "Справочник МестаХранения");
		ОписатьОбъектМД(Рез, Метаданные.Документы.Инвентаризация, "Документ Инвентаризация");
	Исключение
		Рез.Добавить("ОШИБКА метаданных: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Рез.Добавить("== Объекты метаданных со словом 'омплект'");
	Для Каждого О Из Метаданные.Справочники Цикл
		Если СтрНайти(О.Имя, "омплект") > 0 Тогда
			Рез.Добавить("Справочник " + О.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого О Из Метаданные.Документы Цикл
		Если СтрНайти(О.Имя, "омплект") > 0 Тогда
			Рез.Добавить("Документ " + О.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого О Из Метаданные.РегистрыСведений Цикл
		Если СтрНайти(О.Имя, "омплект") > 0 Тогда
			Рез.Добавить("РегистрСведений " + О.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого О Из Метаданные.РегистрыНакопления Цикл
		Если СтрНайти(О.Имя, "омплект") > 0 Тогда
			Рез.Добавить("РегистрНакопления " + О.Имя);
		КонецЕсли;
	КонецЦикла;

	// Найти комплект на остатках и места рядом.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 3
	|	О.Номенклатура КАК Карточка,
	|	О.МестоХранения КАК Место,
	|	О.МестоХранения.Родитель КАК Родитель,
	|	ЕСТЬNULL(О.МестоХранения.ВидМестаХранения.Наименование, """") КАК Вид
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0
	|	И О.Номенклатура.Наименование ПОДОБНО ""Комплект:%""";
	Выб = Запрос.Выполнить().Выбрать();
	Образец = Неопределено;
	Родитель = Неопределено;
	Пока Выб.Следующий() Цикл
		Рез.Добавить("комплект на остатках: " + Строка(Выб.Карточка) + " | место=" + Строка(Выб.Место) + " | вид=" + Выб.Вид + " | родитель=" + Строка(Выб.Родитель));
		Если Образец = Неопределено Тогда
			Образец = Выб.Карточка;
			Родитель = Выб.Родитель;
		КонецЕсли;
	КонецЦикла;

	Если Образец <> Неопределено Тогда
		Рез.Добавить("== Реквизиты карточки-комплекта " + Строка(Образец));
		Объект = Образец.ПолучитьОбъект();
		Для Каждого Р Из Метаданные.Справочники.КарточкиНоменклатуры.Реквизиты Цикл
			Рез.Добавить("  " + Р.Имя + " = " + Строка(Объект[Р.Имя]));
		КонецЦикла;
		// Кто ссылается на комплект через реквизиты-ссылки на карточки.
		Для Каждого Р Из Метаданные.Справочники.КарточкиНоменклатуры.Реквизиты Цикл
			Если Р.Тип.СодержитТип(Тип("СправочникСсылка.КарточкиНоменклатуры")) Тогда
				З = Новый Запрос;
				З.УстановитьПараметр("К", Образец);
				З.Текст = "ВЫБРАТЬ К.Ссылка КАК Ссылка ИЗ Справочник.КарточкиНоменклатуры КАК К ГДЕ К." + Р.Имя + " = &К";
				Т = З.Выполнить().Выгрузить();
				Рез.Добавить("  кто ссылается через " + Р.Имя + ": " + Т.Количество());
				Н = 0;
				Для Каждого Стр Из Т Цикл
					Н = Н + 1;
					Если Н > 8 Тогда
						Прервать;
					КонецЕсли;
					Рез.Добавить("      " + Строка(Стр.Ссылка));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Таблица инвентаризации по месту-родителю с подчиненными и без.
	Если Родитель <> Неопределено И ЗначениеЗаполнено(Родитель) Тогда
		Орг = Справочники.Организации.ПустаяСсылка();
		З = Новый Запрос;
		З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК О ГДЕ НЕ О.ПометкаУдаления И О.Наименование ПОДОБНО ""%Центр Букетов%""";
		В = З.Выполнить().Выбрать();
		Если В.Следующий() Тогда
			Орг = В.Ссылка;
		КонецЕсли;
		Для Н = 0 По 1 Цикл
			СП = (Н = 1);
			Документ = Документы.Инвентаризация.СоздатьДокумент();
			Документ.Организация = Орг;
			Документ.МестоХранения = Родитель;
			Документ.СУчетомПодчиненныхМестХранения = СП;
			Попытка
				Таблица = Документы.Инвентаризация.ТаблицаИнвентаризацииПоОстаткам(Документ);
				Рез.Добавить("== ТаблицаИнвентаризацииПоОстаткам, место=" + Строка(Родитель) + ", с подчиненными=" + СП + ", строк=" + Таблица.Количество());
				Кол = "";
				Для Каждого К Из Таблица.Колонки Цикл
					Кол = Кол + К.Имя + "; ";
				КонецЦикла;
				Рез.Добавить("колонки: " + Кол);
				Сч = 0;
				Для Каждого Стр Из Таблица Цикл
					Сч = Сч + 1;
					Если Сч > 14 Тогда
						Прервать;
					КонецЕсли;
					Т = "";
					Для Каждого К Из Таблица.Колонки Цикл
						Т = Т + Строка(Стр[К.Имя]) + " | ";
					КонецЦикла;
					Рез.Добавить(Т);
				КонецЦикла;
			Исключение
				Рез.Добавить("ОШИБКА таблицы: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

// Проверка комплектов в инвентаризации планшета.
Функция ТестКомплект() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	О.Номенклатура КАК Карточка,
	|	О.МестоХранения КАК Место
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, ) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0
	|	И ТИПЗНАЧЕНИЯ(О.Номенклатура) = ТИП(Справочник.КарточкиНоменклатуры)
	|	И О.Номенклатура.Наименование ПОДОБНО ""Комплект:%""
	|	И О.МестоХранения.Родитель <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)";
	ТекстБазовый = Запрос.Текст;
	Запрос.Текст = ТекстБазовый + "
	|	И О.Номенклатура В (ВЫБРАТЬ КК.Комплект ИЗ РегистрНакопления.Комплектация.Остатки КАК КК ГДЕ КК.КоличествоОстаток > 0 И КК.Номенклатура <> КК.Комплект)";
	Выб = Запрос.Выполнить().Выбрать();
	Рез.Добавить("комплект с составом найден: " + Выб.Следующий());
	Если Выб.Количество() = 0 Тогда
		Запрос.Текст = ТекстБазовый;
		Выб = Запрос.Выполнить().Выбрать();
		Выб.Следующий();
	КонецЕсли;
	Если Выб.Количество() = 0 Тогда
		Возврат "комплект на месте с родителем не найден";
	КонецЕсли;
	Карточка = Выб.Карточка;
	Место = Выб.Место;
	Родитель = Место.Родитель;
	КарточкаИд = Строка(Карточка.УникальныйИдентификатор());
	Рез.Добавить("комплект: " + Строка(Карточка) + " | место: " + Строка(Место) + " | родитель: " + Строка(Родитель));
	Для Н = 0 По 1 Цикл
		СП = (Н = 1);
		Отв = ПрочитатьОтвет(СкладПланшетСервер.ИнвЗагрузить(ЗапросТело(Новый Структура("place,children", Строка(Родитель.УникальныйИдентификатор()), СП))));
		Если Отв["ok"] <> Истина Тогда
			Рез.Добавить("iload children=" + СП + " ошибка: " + Отв["error"]);
			Продолжить;
		КонецЕсли;
		Строки = Отв["rows"];
		Ключи = Новый Соответствие;
		Дубли = 0;
		СКомплектом = 0;
		СамКомплект = 0;
		Для Каждого Р Из Строки Цикл
			Если Ключи.Получить(Р["key"]) <> Неопределено Тогда
				Дубли = Дубли + 1;
			КонецЕсли;
			Ключи.Вставить(Р["key"], Истина);
			Если Р["kit"] <> "" Тогда
				СКомплектом = СКомплектом + 1;
			КонецЕсли;
			Если Р["id"] = КарточкаИд Тогда
				СамКомплект = СамКомплект + 1;
			КонецЕсли;
		КонецЦикла;
		Рез.Добавить("iload children=" + СП + ": строк=" + Строки.Количество() + ", комплектующих=" + СКомплектом + ", строк самого комплекта=" + СамКомплект + ", дублей ключа=" + Дубли);
	КонецЦикла;
	// Скан комплекта: от родителя (under=истина) и от его же места (under=ложь).
	Отв1 = СкладПланшетСервер.ИнвСкан(ЗапросТело(Новый Структура("card,place", КарточкаИд, Строка(Родитель.УникальныйИдентификатор()))));
	Рез.Добавить("скан от родителя: " + КоротКо(Отв1));
	Отв2 = СкладПланшетСервер.ИнвСкан(ЗапросТело(Новый Структура("card,place", КарточкаИд, Строка(Место.УникальныйИдентификатор()))));
	Рез.Добавить("скан от своего места: " + КоротКо(Отв2));
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции
