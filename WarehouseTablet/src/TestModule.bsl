Функция ПрочитатьОтвет(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция ЗапросТело(Структура)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Структура);
	Возврат Запись.Закрыть();
КонецФункции

Функция Остаток(Карточка)
	Запрос = Новый Запрос("ВЫБРАТЬ О.МестоХранения КАК М, О.КоличествоОстаток КАК К ИЗ РегистрНакопления.Остатки.Остатки(, Номенклатура = &К) КАК О ГДЕ О.КоличествоОстаток > 0");
	Запрос.УстановитьПараметр("К", Карточка);
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Строка(Выб.М) + " x" + Выб.К;
	КонецЕсли;
	Возврат "нет остатка";
КонецФункции

Функция Тест() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	Попытка
		Ин = СкладПланшетСервер.Инициализация();
		ОтвИн = ПрочитатьОтвет(Ин);
		Рез.Добавить("init ok=" + ОтвИн["ok"] + " техников=" + ОтвИн["techs"].Количество() + " мест=" + ОтвИн["places"].Количество() + " по умолчанию=" + ОтвИн["defaultTech"]);
		Для Каждого Т Из ОтвИн["techs"] Цикл
			Рез.Добавить("  техник: " + Т["name"]);
		КонецЦикла;
		Рез.Добавить("  размер JSON init: " + СтрДлина(Ин));

		// Кандидаты: штрихкоды карточек с остатком.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 30 Ш.Штрихкод КАК Штрихкод, Ш.Номенклатура КАК Карточка
		|ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
		|ГДЕ ТИПЗНАЧЕНИЯ(Ш.Номенклатура) = ТИП(Справочник.КарточкиНоменклатуры)
		|И Ш.Номенклатура В (ВЫБРАТЬ О.Номенклатура ИЗ РегистрНакопления.Остатки.Остатки() КАК О ГДЕ О.КоличествоОстаток > 0)");
		Выб = Запрос.Выполнить().Выбрать();
		Найден = Ложь;
		Пока Выб.Следующий() Цикл
			Ск = СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", Выб.Штрихкод)));
			ОтвСк = ПрочитатьОтвет(Ск);
			Если ОтвСк["ok"] Тогда
				Найден = Истина;
				Рез.Добавить("scan ШК " + Выб.Штрихкод + ": " + Ск);
				Прервать;
			Иначе
				Рез.Добавить("scan ШК " + Выб.Штрихкод + " отклонен: " + ОтвСк["error"]);
			КонецЕсли;
		КонецЦикла;
		Если Не Найден Тогда
			Рез.Добавить("подходящей карточки не найдено");
			Возврат СтрСоединить(Рез, Символы.ПС);
		КонецЕсли;
		Карточка = Выб.Карточка;
		Штрихкод = Выб.Штрихкод;
		Рез.Добавить("остаток до: " + Остаток(Карточка));

		// Несуществующий штрихкод и повторный скан.
		Рез.Добавить("scan 'xxx': " + СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", "xxx"))));

		ИсхМесто = ОтвСк["place"];
		ИдКарточки = ОтвСк["id"];
		ТехникИд = ОтвИн["defaultTech"];
		Назн = Неопределено;
		Для Каждого П Из ОтвИн["places"] Цикл
			Если П["name"] <> ИсхМесто И П["name"] <> "" Тогда
				Назн = П;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Рез.Добавить("назначение: " + Назн["name"]);

		// Перемещение на то же место (ожидается отказ), потом реальное.
		Ответ1 = СкладПланшетСервер.Переместить(ЗапросТело(Новый Структура("tech,dest,cards", ТехникИд, Назн["id"], Новый Массив)));
		Рез.Добавить("move пустой список: " + Ответ1);
		Масс = Новый Массив; Масс.Добавить(ИдКарточки);
		Ответ2 = СкладПланшетСервер.Переместить(ЗапросТело(Новый Структура("tech,dest,cards", ТехникИд, Назн["id"], Масс)));
		Рез.Добавить("move туда: " + Ответ2);
		Рез.Добавить("остаток после: " + Остаток(Карточка));
		ЗапАвт = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Номер КАК Н, Д.Автор КАК А, Д.Комментарий КАК К ИЗ Документ.Перемещение КАК Д УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ, Д.Номер УБЫВ");
		ВыбАвт = ЗапАвт.Выполнить().Выбрать();
		Если ВыбАвт.Следующий() Тогда
			Рез.Добавить("последний документ: " + ВыбАвт.Н + " автор=" + Строка(ВыбАвт.А) + " коммент=" + ВыбАвт.К);
		КонецЕсли;
		Ответ3 = СкладПланшетСервер.Переместить(ЗапросТело(Новый Структура("tech,dest,cards", ТехникИд, Назн["id"], Масс)));
		Рез.Добавить("move повторно туда же (ждем 'Уже на месте'): " + Ответ3);

		// Вернуть обратно.
		Для Каждого П Из ОтвИн["places"] Цикл
			Если П["name"] = ИсхМесто Тогда
				Ответ4 = СкладПланшетСервер.Переместить(ЗапросТело(Новый Структура("tech,dest,cards", ТехникИд, П["id"], Масс)));
				Рез.Добавить("move обратно: " + Ответ4);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Рез.Добавить("остаток в конце: " + Остаток(Карточка));
		// ---- Инвентаризация ----
		Рез.Добавить("=== ИНВЕНТАРИЗАЦИЯ");
		ИдМеста = Неопределено;
		Для Каждого П Из ОтвИн["places"] Цикл
			Если П["name"] = ИсхМесто Тогда
				ИдМеста = П["id"];
			КонецЕсли;
		КонецЦикла;
		Загр = СкладПланшетСервер.ИнвЗагрузить(ЗапросТело(Новый Структура("place,children", ИдМеста, Ложь)));
		ОтвЗагр = ПрочитатьОтвет(Загр);
		Рез.Добавить("iload ok=" + ОтвЗагр["ok"] + " место=" + ОтвЗагр["place"] + " строк=" + ОтвЗагр["rows"].Количество());
		Рез.Добавить("  начало: " + Лев(Загр, 700));
		ЗагрПодч = СкладПланшетСервер.ИнвЗагрузить(ЗапросТело(Новый Структура("place,children", ИдМеста, Истина)));
		Рез.Добавить("iload с подчиненными строк=" + ПрочитатьОтвет(ЗагрПодч)["rows"].Количество());
		Рез.Добавить("iscan карточки: " + СкладПланшетСервер.ИнвСкан(ЗапросТело(Новый Структура("barcode", Штрихкод))));

		// Лишняя карточка: любая с остатком на другом месте.
		ЗапЛ = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 О.Номенклатура КАК К ИЗ РегистрНакопления.Остатки.Остатки(, МестоХранения <> &М И Номенклатура ССЫЛКА Справочник.КарточкиНоменклатуры) КАК О ГДЕ О.КоличествоОстаток > 0");
		ЗапЛ.УстановитьПараметр("М", Справочники.МестаХранения.ПолучитьСсылку(Новый УникальныйИдентификатор(ИдМеста)));
		ВыбЛ = ЗапЛ.Выполнить().Выбрать();
		Экстры = Новый Массив;
		Если ВыбЛ.Следующий() Тогда
			Экстры.Добавить(Новый Структура("kind,id,fact", "card", Строка(ВыбЛ.К.УникальныйИдентификатор()), 1));
		КонецЕсли;
		СтрокиФакт = Новый Массив;
		Н = 0;
		Для Каждого Р Из ОтвЗагр["rows"] Цикл
			Н = Н + 1;
			Если Р["kind"] = "card" Тогда
				Если Н = 1 Тогда
					СтрокиФакт.Добавить(Новый Структура("key,fact", Р["key"], 1));
				КонецЕсли;
			Иначе
				СтрокиФакт.Добавить(Новый Структура("key,fact", Р["key"], 3));
			КонецЕсли;
		КонецЦикла;
		Сохр = СкладПланшетСервер.ИнвСохранить(ЗапросТело(Новый Структура("tech,place,children,rows,extras", ТехникИд, ИдМеста, Ложь, СтрокиФакт, Экстры)));
		Рез.Добавить("isave: " + Сохр);
		ЗапД = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Док, Д.Номер КАК Н, Д.Проведен КАК Пр, Д.Автор КАК А, Д.Комментарий КАК К, Д.Организация КАК О, Д.МестоХранения КАК М, Д.ОтветственныйСотрудникИТОтдела КАК ИТ ИЗ Документ.Инвентаризация КАК Д УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ, Д.Номер УБЫВ");
		ВыбД = ЗапД.Выполнить().Выбрать();
		Если ВыбД.Следующий() Тогда
			Рез.Добавить("док: " + ВыбД.Н + " проведен=" + ВыбД.Пр + " автор=" + Строка(ВыбД.А) + " орг=" + Строка(ВыбД.О) + " место=" + Строка(ВыбД.М) + " сотрИТ=" + Строка(ВыбД.ИТ) + " коммент=" + ВыбД.К);
			Об = ВыбД.Док.ПолучитьОбъект();
			Рез.Добавить("  строк в ТЧ: " + Об.Номенклатура.Количество());
			К = 0;
			Для Каждого С Из Об.Номенклатура Цикл
				К = К + 1;
				Если К > 8 Тогда
					Прервать;
				КонецЕсли;
				Рез.Добавить("  " + Строка(С.Номенклатура) + " | карт=" + Строка(С.КарточкаНоменклатуры) + " | уч=" + С.КоличествоУчет + " факт=" + С.Количество + " откл=" + С.Отклонение + " | место=" + Строка(С.МестоХранения));
			КонецЦикла;
		КонецЕсли;

	Исключение
		Рез.Добавить("ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция ТестДобавление() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Пои = ПрочитатьОтвет(СкладПланшетСервер.ПоискНоменклатуры(ЗапросТело(Новый Структура("q", "logitech  k"))));
		Рез.Добавить("поиск 'logitech  k': ok=" + Пои["ok"] + " найдено=" + Пои["items"].Количество());
		Для Каждого Эл Из Пои["items"] Цикл
			Рез.Добавить("   " + Эл["name"] + " | по карточкам=" + Эл["card"]);
		КонецЦикла;
		Образец = Справочники.КарточкиНоменклатуры.НайтиПоНаименованию("A4TECH BLOODY HS-50", Ложь);
		Позиция = Образец.Владелец;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.МестоХранения КАК М ИЗ Документ.Поступление КАК Д ГДЕ Д.ВидДокумента = ЗНАЧЕНИЕ(Перечисление.ВидДокументаПоступления.ВводОстатков) И Д.Проведен УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ");
		Выб = Запрос.Выполнить().Выбрать();
		Выб.Следующий();
		Место = Выб.М;
		Ин = ПрочитатьОтвет(СкладПланшетСервер.Инициализация());
		Рез.Добавить("принтеров в init: " + Ин["printers"].Количество());
		Для Каждого Пр Из Ин["printers"] Цикл
			Рез.Добавить("   принтер id=[" + Пр["id"] + "] " + Пр["name"]);
		КонецЦикла;
		Тело = Новый Структура("tech,item,serial,place", Ин["defaultTech"], Строка(Позиция.УникальныйИдентификатор()), "ТЕСТ-ДОБ-001", Строка(Место.УникальныйИдентификатор()));
		Ответ1 = СкладПланшетСервер.ДобавитьПоступление(ЗапросТело(Тело));
		Рез.Добавить("добавление: " + Ответ1);
		О1 = ПрочитатьОтвет(Ответ1);
		Если О1["ok"] Тогда
			Ск = СкладПланшетСервер.Скан(ЗапросТело(Новый Структура("barcode", О1["barcode"])));
			Рез.Добавить("скан нового штрихкода: " + Ск);
			Рез.Добавить("остаток карточки: " + Остаток(Справочники.КарточкиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(О1["id"]))));
			Рез.Добавить("место ожидалось: " + Место);
			Ответ2 = СкладПланшетСервер.ДобавитьПоступление(ЗапросТело(Тело));
			Рез.Добавить("повтор того же с/н (должна быть ошибка): " + Ответ2);
			Тело.serial = "ТЕСТ-ДОБ-002";
			О3 = ПрочитатьОтвет(СкладПланшетСервер.ДобавитьПоступление(ЗапросТело(Тело)));
			Рез.Добавить("второе с другим с/н: ok=" + О3["ok"] + " штрихкод=" + ?(О3["ok"], О3["barcode"], О3["error"]));
			Рез.Добавить("печать без принтера: " + СкладПланшетСервер.ПечатьШтрихкода(ЗапросТело(Новый Структура("printer,card", "0", О1["id"]))));
			Рез.Добавить("ЗПЛ:" + Символы.ПС + СкладПланшетСервер.ТекстЗПЛ(О1["name"], "ТЕСТ-ДОБ-001", О1["barcode"]));
		КонецЕсли;
	Исключение
		Рез.Добавить("ИСКЛЮЧЕНИЕ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОтменитьТранзакцию();
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция ТестПечати(Путь) Экспорт
	Ошибка = СкладПланшетСервер.ОтправитьНаПринтер(Путь, СкладПланшетСервер.ТекстЗПЛ("Клавиатура Logitech K120 беспроводная чёрная", "SN-12345678", "2000000019741"));
	Возврат ?(Ошибка = "", "отправлено", "ОШИБКА: " + Ошибка);
КонецФункции

Функция ПоследняяИнвентаризацияПланшета()
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Док ИЗ Документ.Инвентаризация КАК Д ГДЕ Д.Комментарий ПОДОБНО ""Инвентаризация со склада (планшет)%"" УПОРЯДОЧИТЬ ПО Д.ДатаСоздания УБЫВ, Д.Номер УБЫВ");
	Выб = Запрос.Выполнить().Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Док;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ТестИнв2() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	НачатьТранзакцию();
	Попытка
		Ин = ПрочитатьОтвет(СкладПланшетСервер.Инициализация());
		ТехникИд = Ин["defaultTech"];
		Потер = СкладПланшетСервер.МестоПотеряшки();
		Рез.Добавить("место Потеряшки: " + ?(Потер = Неопределено, "НЕ НАЙДЕНО", Строка(Потер)));

		// --- Пустое место ---
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 М.Ссылка КАК М
		|ИЗ Справочник.МестаХранения КАК М
		|ГДЕ НЕ М.ПометкаУдаления И НЕ М.Ссылка В (ВЫБРАТЬ О.МестоХранения ИЗ РегистрНакопления.Остатки.Остатки КАК О ГДЕ О.КоличествоОстаток > 0)
		|И НЕ М.Ссылка В (ВЫБРАТЬ М2.Родитель ИЗ Справочник.МестаХранения КАК М2)
		|УПОРЯДОЧИТЬ ПО М.Наименование");
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			ИдПустого = Строка(Выб.М.УникальныйИдентификатор());
			Рез.Добавить("пустое место: " + Выб.М);
			Т1 = Новый Структура("tech,place,children,rows,extras", ТехникИд, ИдПустого, Ложь, Новый Массив, Новый Массив);
			Рез.Добавить("isave пустого без подтверждения: " + СкладПланшетСервер.ИнвСохранить(ЗапросТело(Т1)));
			Т1.Вставить("empty", Истина);
			Рез.Добавить("isave пустого с подтверждением: " + СкладПланшетСервер.ИнвСохранить(ЗапросТело(Т1)));
			Док = ПоследняяИнвентаризацияПланшета();
			Если Док <> Неопределено Тогда
				Об = Док.ПолучитьОбъект();
				Рез.Добавить("  док " + Об.Номер + " место=" + Строка(Об.МестоХранения) + " строк=" + Об.Номенклатура.Количество());
				Попытка
					Об.Записать(РежимЗаписиДокумента.Проведение);
					Рез.Добавить("  проведение пустого: ок, проведен=" + Об.Проведен);
				Исключение
					Рез.Добавить("  проведение пустого: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;
			КонецЕсли;
		Иначе
			Рез.Добавить("пустого конечного места не найдено");
		КонецЕсли;

		// --- Недостающие на Потеряшки ---
		Если Потер <> Неопределено Тогда
			ЗапМ = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 О.МестоХранения КАК М, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Номенклатура) КАК Н
			|ИЗ РегистрНакопления.Остатки.Остатки(, Номенклатура ССЫЛКА Справочник.КарточкиНоменклатуры) КАК О
			|ГДЕ О.КоличествоОстаток > 0 И О.МестоХранения <> &П
			|СГРУППИРОВАТЬ ПО О.МестоХранения
			|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Номенклатура) >= 1
			|УПОРЯДОЧИТЬ ПО Н");
			ЗапМ.УстановитьПараметр("П", Потер);
			ВыбМ = ЗапМ.Выполнить().Выбрать();
			Если ВыбМ.Следующий() Тогда
				ИдМ = Строка(ВыбМ.М.УникальныйИдентификатор());
				Рез.Добавить("место с карточками: " + ВыбМ.М + " (карточек " + ВыбМ.Н + ")");
				Т2 = Новый Структура("tech,place,children,rows,extras,lost", ТехникИд, ИдМ, Ложь, Новый Массив, Новый Массив, Истина);
				Рез.Добавить("isave недостач на Потеряшки: " + СкладПланшетСервер.ИнвСохранить(ЗапросТело(Т2)));
				Док = ПоследняяИнвентаризацияПланшета();
				Если Док <> Неопределено Тогда
					Об = Док.ПолучитьОбъект();
					Рез.Добавить("  док " + Об.Номер + " строк=" + Об.Номенклатура.Количество());
					Карточка = Неопределено;
					Для Каждого С Из Об.Номенклатура Цикл
						Если С.МестоХранения = Потер Тогда
							Карточка = С.КарточкаНоменклатуры;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если Карточка <> Неопределено Тогда
						Рез.Добавить("  остаток до проведения: " + Остаток(Карточка));
					КонецЕсли;
					Попытка
						Об.Записать(РежимЗаписиДокумента.Проведение);
						Рез.Добавить("  проведение: ок");
						Если Карточка <> Неопределено Тогда
							Рез.Добавить("  остаток после проведения: " + Остаток(Карточка) + " (ожидалось: Потеряшки)");
						КонецЕсли;
					Исключение
						Рез.Добавить("  проведение: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
				КонецЕсли;
			Иначе
				Рез.Добавить("места с карточками не найдено");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Рез.Добавить("ИСКЛЮЧЕНИЕ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ОтменитьТранзакцию();
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция БалансыКарточки(Карточка)
	Запрос = Новый Запрос("ВЫБРАТЬ О.МестоХранения КАК М, О.КоличествоОстаток КАК К ИЗ РегистрНакопления.Остатки.Остатки(, Номенклатура = &К) КАК О");
	Запрос.УстановитьПараметр("К", Карточка);
	Выб = Запрос.Выполнить().Выбрать();
	Текст = "";
	Пока Выб.Следующий() Цикл
		Текст = Текст + Строка(Выб.М) + " x" + Выб.К + "; ";
	КонецЦикла;
	Возврат ?(Текст = "", "нет записей", Текст);
КонецФункции

Функция ДвиженияДокумента(Док)
	Запрос = Новый Запрос("ВЫБРАТЬ Д.ВидДвижения КАК Вид, Д.МестоХранения КАК М, Д.Номенклатура КАК Н, Д.Количество КАК Кол ИЗ РегистрНакопления.Остатки КАК Д ГДЕ Д.Регистратор = &Д");
	Запрос.УстановитьПараметр("Д", Док);
	Выб = Запрос.Выполнить().Выбрать();
	Текст = "";
	Пока Выб.Следующий() Цикл
		Текст = Текст + "    " + Выб.Вид + " | " + Строка(Выб.М) + " | " + Строка(Выб.Н) + " | " + Выб.Кол + Символы.ПС;
	КонецЦикла;
	Возврат ?(Текст = "", "    (движений по Остатки нет)" + Символы.ПС, Текст);
КонецФункции

Функция СостоянияКарточки(Карточка)
	Запрос = Новый Запрос("ВЫБРАТЬ С.Период КАК П, С.Состояние КАК С, С.Регистратор КАК Р ИЗ РегистрСведений.СостояниеКарточекНоменклатуры КАК С ГДЕ С.КарточкаНоменклатуры = &К УПОРЯДОЧИТЬ ПО С.Период");
	Запрос.УстановитьПараметр("К", Карточка);
	Выб = Запрос.Выполнить().Выбрать();
	Текст = "";
	Пока Выб.Следующий() Цикл
		Текст = Текст + "    " + Формат(Выб.П, "ДФ=dd.MM.yyyy") + " | " + Строка(Выб.С) + " | " + Строка(Выб.Р) + Символы.ПС;
	КонецЦикла;
	Возврат ?(Текст = "", "    (состояний нет)" + Символы.ПС, Текст);
КонецФункции

Функция ДиагОдин(НаПотеряшки)
	Рез = "";
	НачатьТранзакцию();
	Попытка
		Ин = ПрочитатьОтвет(СкладПланшетСервер.Инициализация());
		Потер = СкладПланшетСервер.МестоПотеряшки();
		ЗапМ = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 О.МестоХранения КАК М, О.Номенклатура КАК К
		|ИЗ РегистрНакопления.Остатки.Остатки(, Номенклатура ССЫЛКА Справочник.КарточкиНоменклатуры) КАК О
		|ГДЕ О.КоличествоОстаток > 0 И О.МестоХранения <> &П И О.МестоХранения.Наименование = ""TEMPEMPTY11""");
		ЗапМ.УстановитьПараметр("П", Потер);
		Выб = ЗапМ.Выполнить().Выбрать();
		Если Не Выб.Следующий() Тогда
			Возврат "нет карточки на TEMPEMPTY11";
		КонецЕсли;
		Карточка = Выб.К;
		Рез = Рез + "карточка: " + Строка(Карточка) + Символы.ПС;
		Рез = Рез + "до: " + БалансыКарточки(Карточка) + Символы.ПС;
		Т = Новый Структура("tech,place,children,rows,extras,lost", Ин["defaultTech"], Строка(Выб.М.УникальныйИдентификатор()), Ложь, Новый Массив, Новый Массив, НаПотеряшки);
		Рез = Рез + "isave: " + СкладПланшетСервер.ИнвСохранить(ЗапросТело(Т)) + Символы.ПС;
		Док = ПоследняяИнвентаризацияПланшета();
		Об = Док.ПолучитьОбъект();
		Для Каждого С Из Об.Номенклатура Цикл
			Рез = Рез + "  строка: " + Строка(С.КарточкаНоменклатуры) + " | место=" + Строка(С.МестоХранения) + " | уч=" + С.КоличествоУчет + " факт=" + С.Количество + " откл=" + С.Отклонение + Символы.ПС;
		КонецЦикла;
		Об.Записать(РежимЗаписиДокумента.Проведение);
		Рез = Рез + "проведен. движения по Остатки:" + Символы.ПС + ДвиженияДокумента(Док);
		Рез = Рез + "после: " + БалансыКарточки(Карточка) + Символы.ПС;
		Рез = Рез + "состояния карточки:" + Символы.ПС + СостоянияКарточки(Карточка);
	Исключение
		Рез = Рез + "ИСКЛЮЧЕНИЕ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ОтменитьТранзакцию();
	Возврат Рез;
КонецФункции

