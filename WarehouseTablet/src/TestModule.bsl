			Рез.Добавить("  " + Строка(Выб.Карточка) + " | " + Строка(Выб.Место) + " | " + Формат(Выб.Период, "ДФ=dd.MM.yyyy") + " | " + Строка(Выб.Док) + " | " + Выб.Кол);
