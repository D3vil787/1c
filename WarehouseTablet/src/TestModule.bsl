Функция ТестТрасса(Серийный) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Рез = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК К, К.Наименование КАК Имя, К.ПометкаУдаления КАК Удален ИЗ Справочник.КарточкиНоменклатуры КАК К ГДЕ К.СерийныйНомер ПОДОБНО &С");
	Запрос.УстановитьПараметр("С", "%" + Серийный + "%");
	Выб = Запрос.Выполнить().Выбрать();
	Карточки = Новый Массив;
	Пока Выб.Следующий() Цикл
		Карточки.Добавить(Выб.К);
		Рез.Добавить("карточка: " + Выб.Имя + " | пометка удаления=" + Выб.Удален);
	КонецЦикла;
	Если Карточки.Количество() = 0 Тогда
		Возврат "карточка с серийным номером " + Серийный + " не найдена";
	КонецЕсли;
	Для Каждого Карточка Из Карточки Цикл
		Рез.Добавить("=== " + Строка(Карточка));
		Рез.Добавить("остатки сейчас: " + БалансыКарточки(Карточка));
		Попытка
			З = Новый Запрос("ВЫБРАТЬ Д.Период КАК П, Д.Регистратор КАК Р, Д.ВидДвижения КАК Вид, Д.МестоХранения КАК М, Д.Количество КАК Кол ИЗ РегистрНакопления.Остатки КАК Д ГДЕ Д.Номенклатура = &К УПОРЯДОЧИТЬ ПО Д.Период, Д.НомерСтроки");
			З.УстановитьПараметр("К", Карточка);
			В = З.Выполнить().Выбрать();
			Рез.Добавить("--- движения по регистру Остатки:");
			Пока В.Следующий() Цикл
				Рез.Добавить("  " + Формат(В.П, "ДФ='dd.MM.yyyy HH:mm:ss'") + " | " + Строка(В.Р) + " | " + В.Вид + " | " + Строка(В.М) + " | " + В.Кол);
			КонецЦикла;
		Исключение
			Рез.Добавить("ошибка движений: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Рез.Добавить("--- состояния:" + Символы.ПС + СоставнойТекст(СостоянияКарточки(Карточка)));
		Попытка
			З = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Док, С.Ссылка.Дата КАК Дата, С.Ссылка.Проведен КАК Пр, С.Ссылка.МестоХранения КАК МД, С.МестоХранения КАК МС, С.КоличествоУчет КАК Уч, С.Количество КАК Факт, С.Отклонение КАК Откл ИЗ Документ.Инвентаризация.Номенклатура КАК С ГДЕ С.КарточкаНоменклатуры = &К УПОРЯДОЧИТЬ ПО С.Ссылка.Дата");
			З.УстановитьПараметр("К", Карточка);
			В = З.Выполнить().Выбрать();
			Рез.Добавить("--- строки инвентаризаций:");
			Пока В.Следующий() Цикл
				Рез.Добавить("  " + Строка(В.Док) + " | проведен=" + В.Пр + " | место док=" + Строка(В.МД) + " | место стр=" + Строка(В.МС) + " | уч=" + В.Уч + " факт=" + В.Факт + " откл=" + В.Откл);
			КонецЦикла;
		Исключение
			Рез.Добавить("ошибка инвентаризаций: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Попытка
			З = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Док, С.Ссылка.Дата КАК Дата, С.Ссылка.Проведен КАК Пр, С.Ссылка.МестоХранения КАК М, С.Ссылка.Основание КАК Осн, С.Ссылка.Комментарий КАК Ком ИЗ Документ.Списание.Номенклатура КАК С ГДЕ С.КарточкаНоменклатуры = &К УПОРЯДОЧИТЬ ПО С.Ссылка.Дата");
			З.УстановитьПараметр("К", Карточка);
			В = З.Выполнить().Выбрать();
			Рез.Добавить("--- списания:");
			Пока В.Следующий() Цикл
				Рез.Добавить("  " + Строка(В.Док) + " | проведен=" + В.Пр + " | место=" + Строка(В.М) + " | основание=" + Строка(В.Осн) + " | коммент=" + В.Ком);
			КонецЦикла;
		Исключение
			Рез.Добавить("ошибка списаний: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

