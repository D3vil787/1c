// Все вложенные места (на любую глубину).
Процедура СобратьПотомков(Корень, Дети, Результат)
	Стек = Новый Массив;
	Стек.Добавить(Корень);
	Пока Стек.Количество() > 0 Цикл
		Текущий = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		Список = Дети.Получить(Текущий);
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Д Из Список Цикл
			Если Результат.Получить(Д) = Неопределено Тогда
				Результат.Вставить(Д, Истина);
				Стек.Добавить(Д);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Даты инвентаризации по местам хранения с учетом иерархии:
//   Дата      - последняя проведенная инвентаризация места (в т.ч. документом "с учетом подчиненных" по родителю);
//   Старая    - самая давняя дата среди самого места (если оно учитывается) и всех вложенных;
//   Полнота   - "проверено из всего" по месту и вложенным (только для мест, у которых есть вложенные).
// СрокМесяцев: 0 - без срока; иначе "сделанным" считается место, инвентаризация которого не старше этого срока.
// Итоги (Структура, необязательно): Всего (конечных мест), Сделано, Срез (граничная дата).
// ТолькоНевыполненные: исключить из таблицы места, по которым за срок все уже проверено.
Функция ТаблицаДат(СрокМесяцев = 0, Итоги = Неопределено, ТолькоНевыполненные = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	М.Ссылка КАК Место,
	|	М.Родитель КАК Родитель,
	|	М.ПометкаУдаления КАК Удалено,
	|	ЕСТЬNULL(М.ВидМестаХранения.Наименование, """") КАК Вид
	|ИЗ
	|	Справочник.МестаХранения КАК М
	|;
	|
	|ВЫБРАТЬ
	|	Док.МестоХранения КАК Место,
	|	Док.СУчетомПодчиненныхМестХранения КАК СПодчиненными,
	|	МАКСИМУМ(Док.Дата) КАК Дата
	|ИЗ
	|	Документ.Инвентаризация КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.МестоХранения <> ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Док.МестоХранения,
	|	Док.СУчетомПодчиненныхМестХранения
	|;
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	О.МестоХранения КАК Место
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";

	Результаты = Запрос.ВыполнитьПакет();

	Родители = Новый Соответствие;
	Дети = Новый Соответствие;
	Исключены = Новый Соответствие;
	Порядок = Новый Массив;
	Выб = Результаты[0].Выбрать();
	Пока Выб.Следующий() Цикл
		Родители.Вставить(Выб.Место, Выб.Родитель);
		Если Выб.Удалено Или Выб.Вид = "Рабочее место" Тогда
			Исключены.Вставить(Выб.Место, Истина);
		КонецЕсли;
		Список = Дети.Получить(Выб.Родитель);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Дети.Вставить(Выб.Родитель, Список);
		КонецЕсли;
		Список.Добавить(Выб.Место);
		Порядок.Добавить(Выб.Место);
	КонецЦикла;

	// Дата инвентаризации каждого места: свой документ или документ "с подчиненными" по любому родителю.
	Даты = Новый Соответствие;
	СвоиДаты = Новый Соответствие;
	Выб = Результаты[1].Выбрать();
	Пока Выб.Следующий() Цикл
		Охват = Новый Соответствие;
		Охват.Вставить(Выб.Место, Истина);
		Если Выб.СПодчиненными Тогда
			СобратьПотомков(Выб.Место, Дети, Охват);
		КонецЕсли;
		Для Каждого КЗ Из Охват Цикл
			Тек = Даты.Получить(КЗ.Ключ);
			Если Тек = Неопределено Или Тек < Выб.Дата Тогда
				Даты.Вставить(КЗ.Ключ, Выб.Дата);
			КонецЕсли;
		КонецЦикла;
		Если Выб.Место <> Неопределено Тогда
			Тек = СвоиДаты.Получить(Выб.Место);
			Если Тек = Неопределено Или Тек < Выб.Дата Тогда
				СвоиДаты.Вставить(Выб.Место, Выб.Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЕстьОстаток = Новый Соответствие;
	Выб = Результаты[2].Выбрать();
	Пока Выб.Следующий() Цикл
		ЕстьОстаток.Вставить(Выб.Место, Истина);
	КонецЦикла;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Место");
	Результат.Колонки.Добавить("Родитель");
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Старая");
	Результат.Колонки.Добавить("Всего");
	Результат.Колонки.Добавить("Проверено");
	Результат.Колонки.Добавить("Полнота");
	Результат.Колонки.Добавить("Процент");

	ПустаяДата = Дата(1, 1, 1);
	Срез = ПустаяДата;
	Если СрокМесяцев > 0 Тогда
		Срез = НачалоДня(ДобавитьМесяц(ТекущаяДатаСеанса(), -СрокМесяцев));
	КонецЕсли;
	ВсегоМест = 0;
	СделаноМест = 0;

	Для Каждого Место Из Порядок Цикл
		Если Исключены.Получить(Место) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Потомки = Новый Соответствие;
		СобратьПотомков(Место, Дети, Потомки);
		Состав = Новый Массив;
		ЕстьВложенные = Ложь;
		Для Каждого КЗ Из Потомки Цикл
			Если Исключены.Получить(КЗ.Ключ) = Неопределено Тогда
				Состав.Добавить(КЗ.Ключ);
				ЕстьВложенные = Истина;
			КонецЕсли;
		КонецЦикла;

		СамоеДата = Даты.Получить(Место);
		// Само место входит в состав, если оно конечное, либо на нем есть остатки, либо по нему уже проводили инвентаризацию.
		Если Не ЕстьВложенные Или ЕстьОстаток.Получить(Место) <> Неопределено Или СамоеДата <> Неопределено Тогда
			Состав.Добавить(Место);
		КонецЕсли;

		Проверено = 0;
		Старая = Неопределено;
		Для Каждого М Из Состав Цикл
			Д = Даты.Получить(М);
			Если Д <> Неопределено Тогда
				Если Д >= Срез Тогда
					Проверено = Проверено + 1;
				КонецЕсли;
				Если Старая = Неопределено Или Д < Старая Тогда
					Старая = Д;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;

		Выполнено = (Проверено >= Состав.Количество());
		Если Не ЕстьВложенные Тогда
			ВсегоМест = ВсегоМест + 1;
			Если Выполнено Тогда
				СделаноМест = СделаноМест + 1;
			КонецЕсли;
		КонецЕсли;
		Если ТолькоНевыполненные И Выполнено Тогда
			Продолжить;
		КонецЕсли;

		Стр = Результат.Добавить();
		Стр.Место = Место;
		Стр.Родитель = Родители.Получить(Место);
		Стр.Дата = ?(СамоеДата = Неопределено, ПустаяДата, СамоеДата);
		Стр.Старая = ?(Старая = Неопределено, ПустаяДата, Старая);
		Стр.Всего = Состав.Количество();
		Стр.Проверено = Проверено;
		Стр.Полнота = ?(ЕстьВложенные, XMLСтрока(Проверено) + " из " + XMLСтрока(Состав.Количество()), "");
		Стр.Процент = ?(Состав.Количество() = 0, 0, Окр(Проверено * 100 / Состав.Количество(), 0));
	КонецЦикла;

	Если ТипЗнч(Итоги) = Тип("Структура") Тогда
		Итоги.Вставить("Всего", ВсегоМест);
		Итоги.Вставить("Сделано", СделаноМест);
		Итоги.Вставить("Срез", Срез);
	КонецЕсли;

	Результат.Сортировать("Место");
	Возврат Результат;

КонецФункции

// Карточки, которые последняя проведенная инвентаризация не нашла на месте (учет > 0, факт = 0),
// но по учету они все еще числятся на месте: проведение инвентаризации остатки не меняет.
// Из списка исключаются карточки, по которым после инвентаризации было любое движение (перемещение, списание и т.п.).
Функция ТаблицаНеНайденных() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стр.КарточкаНоменклатуры КАК Карточка,
	|	Стр.Ссылка КАК Документ,
	|	Стр.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.Инвентаризация.Номенклатура КАК Стр
	|ГДЕ
	|	Стр.Ссылка.Проведен
	|	И Стр.КарточкаНоменклатуры <> ЗНАЧЕНИЕ(Справочник.КарточкиНоменклатуры.ПустаяСсылка)
	|	И Стр.КарточкаНоменклатуры.Владелец.ВидНоменклатуры.ВестиУчетПоКарточкамНоменклатуры
	|	И Стр.КоличествоУчет > 0
	|	И Стр.Количество = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";

	Кандидаты = Запрос.Выполнить().Выгрузить();

	// Оставляем по каждой карточке только самую свежую недостачу.
	Первые = Новый Соответствие;
	Свежие = Новый Массив;
	Для Каждого Стр Из Кандидаты Цикл
		Если Первые.Получить(Стр.Карточка) = Неопределено Тогда
			Первые.Вставить(Стр.Карточка, Стр);
			Свежие.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Карточка");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Серийный");
	Результат.Колонки.Добавить("Инвентарный");
	Результат.Колонки.Добавить("Место");
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("Статус");

	ДобавитьСписанныеПоИнвентаризации(Результат);

	Если Свежие.Количество() = 0 Тогда
		Результат.Сортировать("Дата УБЫВ, Номенклатура");
		Возврат Результат;
	КонецЕсли;

	Карточки = Новый Массив;
	Для Каждого Стр Из Свежие Цикл
		Карточки.Добавить(Стр.Карточка);
	КонецЦикла;

	// Где карточка числится сейчас.
	ЗапОст = Новый Запрос;
	ЗапОст.Текст =
	"ВЫБРАТЬ
	|	О.Номенклатура КАК Карточка,
	|	О.МестоХранения КАК Место
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, Номенклатура В (&Карточки)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	ЗапОст.УстановитьПараметр("Карточки", Карточки);
	ТекущееМесто = Новый Соответствие;
	Выб = ЗапОст.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		ТекущееМесто.Вставить(Выб.Карточка, Выб.Место);
	КонецЦикла;

	// Последнее движение по карточке.
	ЗапДвиж = Новый Запрос;
	ЗапДвиж.Текст =
	"ВЫБРАТЬ
	|	Д.Номенклатура КАК Карточка,
	|	МАКСИМУМ(Д.Период) КАК Период
	|ИЗ
	|	РегистрНакопления.Остатки КАК Д
	|ГДЕ
	|	Д.Номенклатура В (&Карточки)
	|
	|СГРУППИРОВАТЬ ПО
	|	Д.Номенклатура";
	ЗапДвиж.УстановитьПараметр("Карточки", Карточки);
	ПоследнееДвижение = Новый Соответствие;
	Выб = ЗапДвиж.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		ПоследнееДвижение.Вставить(Выб.Карточка, Выб.Период);
	КонецЦикла;

	// Реквизиты карточек.
	ЗапКарт = Новый Запрос;
	ЗапКарт.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Карточка,
	|	К.Владелец.Наименование КАК Номенклатура,
	|	К.СерийныйНомер КАК Серийный,
	|	К.ИнвентарныйНомер КАК Инвентарный
	|ИЗ
	|	Справочник.КарточкиНоменклатуры КАК К
	|ГДЕ
	|	К.Ссылка В (&Карточки)";
	ЗапКарт.УстановитьПараметр("Карточки", Карточки);
	Реквизиты = Новый Соответствие;
	Выб = ЗапКарт.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Реквизиты.Вставить(Выб.Карточка, Новый Структура("Номенклатура,Серийный,Инвентарный", Выб.Номенклатура, Выб.Серийный, Выб.Инвентарный));
	КонецЦикла;

	Для Каждого Стр Из Свежие Цикл
		Место = ТекущееМесто.Получить(Стр.Карточка);
		Если Место = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Движение = ПоследнееДвижение.Получить(Стр.Карточка);
		Если Движение <> Неопределено И Движение >= Стр.Дата Тогда
			Продолжить;
		КонецЕсли;
		Нов = Результат.Добавить();
		Нов.Карточка = Стр.Карточка;
		Нов.Место = Место;
		Нов.Дата = Стр.Дата;
		Нов.Документ = Стр.Документ;
		Нов.Статус = "Числится на месте, не найдена";
		Рек = Реквизиты.Получить(Стр.Карточка);
		Если Рек <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Нов, Рек);
		КонецЕсли;
	КонецЦикла;

	// Убираем подтвержденные потери: подтверждение действует, если оно сделано не раньше документа.
	Подтв = Новый Соответствие;
	ЗапП = Новый Запрос("ВЫБРАТЬ П.Карточка КАК Карточка, П.Дата КАК Дата ИЗ РегистрСведений.ПодтвержденныеПотери КАК П");
	Выб = ЗапП.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Подтв.Вставить(Выб.Карточка, Выб.Дата);
	КонецЦикла;
	Индекс = Результат.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ДатаПодтв = Подтв.Получить(Результат[Индекс].Карточка);
		Если ДатаПодтв <> Неопределено И ДатаПодтв >= Результат[Индекс].Дата Тогда
			Результат.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Результат.Сортировать("Дата УБЫВ, Номенклатура");
	Возврат Результат;

КонецФункции

// Осознанное подтверждение: предмет действительно пропал, из отчета убирается.
// Если позже предмет найдут и он снова пропадет при инвентаризации, он вернется в отчет.
Функция ПодтвердитьПотери(Карточки, Комментарий = "") Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Кол = 0;
	Если ТипЗнч(Карточки) <> Тип("Массив") Тогда
		Список = Новый Массив;
		Список.Добавить(Карточки);
		Карточки = Список;
	КонецЕсли;
	Для Каждого К Из Карточки Цикл
		Если Не ЗначениеЗаполнено(К) Тогда
			Продолжить;
		КонецЕсли;
		Зап = РегистрыСведений.ПодтвержденныеПотери.СоздатьМенеджерЗаписи();
		Зап.Карточка = К;
		Зап.Дата = ТекущаяДата();
		Зап.Пользователь = Строка(ИмяПользователя());
		Зап.Комментарий = Комментарий;
		Зап.Записать();
		Кол = Кол + 1;
	КонецЦикла;
	Возврат Кол;
КонецФункции


// Карточки, списанные документом Списание, созданным на основании Инвентаризации
// (по версии 1С списаны, фактически пропали). Исключаются карточки, у которых после списания
// снова появился остаток (нашлись и оприходованы).
Процедура ДобавитьСписанныеПоИнвентаризации(Результат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Стр.КарточкаНоменклатуры КАК Карточка,
	|	Стр.Ссылка КАК Документ,
	|	Стр.Ссылка.Дата КАК Дата,
	|	Стр.Ссылка.МестоХранения КАК Место,
	|	Стр.Ссылка.Основание КАК Основание,
	|	Стр.КарточкаНоменклатуры.Владелец.Наименование КАК Номенклатура,
	|	Стр.КарточкаНоменклатуры.СерийныйНомер КАК Серийный,
	|	Стр.КарточкаНоменклатуры.ИнвентарныйНомер КАК Инвентарный
	|ИЗ
	|	Документ.Списание.Номенклатура КАК Стр
	|ГДЕ
	|	Стр.Ссылка.Проведен
	|	И Стр.Ссылка.Основание ССЫЛКА Документ.Инвентаризация
	|	И Стр.КарточкаНоменклатуры <> ЗНАЧЕНИЕ(Справочник.КарточкиНоменклатуры.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Кандидаты = Запрос.Выполнить().Выгрузить();
	Взяты = Новый Соответствие;
	Карточки = Новый Массив;
	Строки = Новый Массив;
	Для Каждого Стр Из Кандидаты Цикл
		Если Взяты.Получить(Стр.Карточка) = Неопределено Тогда
			Взяты.Вставить(Стр.Карточка, Истина);
			Карточки.Добавить(Стр.Карточка);
			Строки.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Если Карточки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Последнее движение по карточке должно быть этим списанием.
	ЗапДвиж = Новый Запрос;
	ЗапДвиж.Текст =
	"ВЫБРАТЬ
	|	Д.Номенклатура КАК Карточка,
	|	МАКСИМУМ(Д.Период) КАК Период
	|ИЗ
	|	РегистрНакопления.Остатки КАК Д
	|ГДЕ
	|	Д.Номенклатура В (&Карточки)
	|СГРУППИРОВАТЬ ПО
	|	Д.Номенклатура";
	ЗапДвиж.УстановитьПараметр("Карточки", Карточки);
	Последнее = Новый Соответствие;
	Выб = ЗапДвиж.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Последнее.Вставить(Выб.Карточка, Выб.Период);
	КонецЦикла;

	ЗапОст = Новый Запрос;
	ЗапОст.Текст =
	"ВЫБРАТЬ
	|	О.Номенклатура КАК Карточка
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, Номенклатура В (&Карточки)) КАК О
	|ГДЕ
	|	О.КоличествоОстаток > 0";
	ЗапОст.УстановитьПараметр("Карточки", Карточки);
	ЕстьОстаток = Новый Соответствие;
	Выб = ЗапОст.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		ЕстьОстаток.Вставить(Выб.Карточка, Истина);
	КонецЦикла;

	Для Каждого Стр Из Строки Цикл
		Если ЕстьОстаток.Получить(Стр.Карточка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Движ = Последнее.Получить(Стр.Карточка);
		Если Движ <> Неопределено И Движ > Стр.Дата Тогда
			Продолжить;
		КонецЕсли;
		Нов = Результат.Добавить();
		Нов.Карточка = Стр.Карточка;
		Нов.Номенклатура = Стр.Номенклатура;
		Нов.Серийный = Стр.Серийный;
		Нов.Инвентарный = Стр.Инвентарный;
		Нов.Место = Стр.Место;
		Нов.Дата = Стр.Дата;
		Нов.Документ = Стр.Документ;
		Нов.Статус = "СПИСАНА по инвентаризации (пропала)";
	КонецЦикла;

КонецПроцедуры

// Для проверки из внешнего соединения.
Функция Сводка() Экспорт
	Т = ТаблицаДат();
	С = "строк=" + Т.Количество() + Символы.ПС;
	Заполнено = 0;
	Для Каждого Стр Из Т Цикл
		Если ЗначениеЗаполнено(Стр.Дата) Тогда
			Заполнено = Заполнено + 1;
		КонецЕсли;
	КонецЦикла;
	С = С + "с датой=" + Заполнено + Символы.ПС;
	С = С + "--- места с вложенными (первые 25):" + Символы.ПС;
	Н = 0;
	Для Каждого Стр Из Т Цикл
		Если Стр.Полнота <> "" Тогда
			Н = Н + 1;
			Если Н <= 25 Тогда
				С = С + Строка(Стр.Место) + " | своя=" + ?(ЗначениеЗаполнено(Стр.Дата), Формат(Стр.Дата, "ДФ=dd.MM.yyyy"), "-")
					+ " | старая=" + ?(ЗначениеЗаполнено(Стр.Старая), Формат(Стр.Старая, "ДФ=dd.MM.yyyy"), "-")
					+ " | " + Стр.Полнота + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	С = С + "мест с вложенными=" + Н + Символы.ПС;
	Н2 = ТаблицаНеНайденных();
	С = С + "--- не найдено при последней инвентаризации (числятся на месте): " + Н2.Количество() + Символы.ПС;
	К = 0;
	Для Каждого Стр Из Н2 Цикл
		К = К + 1;
		Если К > 40 Тогда
			Прервать;
		КонецЕсли;
		С = С + Стр.Номенклатура + " | с/н " + Стр.Серийный + " | " + Строка(Стр.Место) + " | " + Формат(Стр.Дата, "ДФ=dd.MM.yyyy") + " | " + Стр.Статус + Символы.ПС;
	КонецЦикла;
	К = 0;
	Для Каждого Стр Из Н2 Цикл
		Если Найти(Стр.Статус, "СПИСАНА") > 0 Тогда
			К = К + 1;
		КонецЕсли;
	КонецЦикла;
	С = С + "из них списано по инвентаризации: " + К + Символы.ПС;
	Возврат С;
КонецФункции


// Снимает подтверждение (предмет снова попадет в отчет, если он все еще числится пропавшим).
Процедура ОтменитьПодтверждение(Карточка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	МЗ = РегистрыСведений.ПодтвержденныеПотери.СоздатьМенеджерЗаписи();
	МЗ.Карточка = Карточка;
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		МЗ.Удалить();
	КонецЕсли;
КонецПроцедуры

// Для проверки из внешнего соединения: итоги по сроку.
Функция СводкаПериода(СрокМесяцев) Экспорт
	Итоги = Новый Структура;
	Т = ТаблицаДат(СрокМесяцев, Итоги);
	С = "срок=" + СрокМесяцев + " мес., срез=" + Формат(Итоги.Срез, "ДФ=dd.MM.yyyy") + Символы.ПС;
	С = С + "конечных мест=" + Итоги.Всего + ", сделано=" + Итоги.Сделано + ", просрочено=" + (Итоги.Всего - Итоги.Сделано)
		+ ", процент=" + ?(Итоги.Всего = 0, 0, Окр(Итоги.Сделано * 100 / Итоги.Всего, 0)) + Символы.ПС;
	С = С + "строк в таблице=" + Т.Количество() + Символы.ПС;
	Н = 0;
	Для Каждого Стр Из Т Цикл
		Если Стр.Полнота <> "" Тогда
			Н = Н + 1;
			Если Н <= 12 Тогда
				С = С + Строка(Стр.Место) + " | " + Стр.Полнота + " | " + Стр.Процент + "%" + Символы.ПС;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Т2 = ТаблицаДат(СрокМесяцев, Неопределено, Истина);
	С = С + "строк только невыполненных=" + Т2.Количество() + Символы.ПС;
	Возврат С;
КонецФункции
