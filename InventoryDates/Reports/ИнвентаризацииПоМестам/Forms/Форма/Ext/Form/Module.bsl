&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Срок = 6;
	Элементы.Срок.СписокВыбора.Добавить(6, "Не старше полугода (6 месяцев)");
	Элементы.Срок.СписокВыбора.Добавить(12, "Не старше года (12 месяцев)");
КонецПроцедуры

&НаКлиенте
Процедура СрокПриИзменении(Элемент)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТолькоНевыполненныеПриИзменении(Элемент)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Итоги = Новый Структура;
	Список.Загрузить(ИнвДатыСервер.ТаблицаДат(Срок, Итоги, ТолькоНевыполненные));
	Всего = Итоги.Всего;
	Сделано = Итоги.Сделано;
	ПрогрессОбщий = ?(Всего = 0, 0, Окр(Сделано * 100 / Всего, 0));
	Элементы.ИтогТекст.Заголовок = "Проинвентаризировано за период (с " + Формат(Итоги.Срез, "ДФ=dd.MM.yyyy") + "): "
		+ Сделано + " из " + Всего + " мест";
	Элементы.ПросроченоТекст.Заголовок = "Просрочено или ни разу не проверялось: " + (Всего - Сделано);
КонецПроцедуры

&НаКлиенте
Процедура СортМесто(Команда)
	СортироватьНаСервере("Место");
КонецПроцедуры

&НаКлиенте
Процедура СортДатаСтарые(Команда)
	СортироватьНаСервере("Дата, Место");
КонецПроцедуры

&НаКлиенте
Процедура СортСтарая(Команда)
	СортироватьНаСервере("Старая, Место");
КонецПроцедуры

&НаКлиенте
Процедура СортДатаНовые(Команда)
	СортироватьНаСервере("Дата УБЫВ, Место");
КонецПроцедуры

&НаСервере
Процедура СортироватьНаСервере(Правило)
	ТЗ = РеквизитФормыВЗначение("Список");
	ТЗ.Сортировать(Правило);
	ЗначениеВРеквизитФормы(ТЗ, "Список");
КонецПроцедуры
