&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Список.Загрузить(ИнвДатыСервер.ТаблицаНеНайденных());
КонецПроцедуры


&НаКлиенте
Процедура ПодтвердитьПропажу(Команда)
	Выделенные = Элементы.Список.ВыделенныеСтроки;
	Если Выделенные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выделите строки (можно несколько, Ctrl/Shift).");
		Возврат;
	КонецЕсли;
	Идентификаторы = Новый Массив;
	Для Каждого Ид Из Выделенные Цикл
		Идентификаторы.Добавить(Ид);
	КонецЦикла;
	ПодтвердитьНаСервере(Идентификаторы);
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьНаСервере(Идентификаторы)
	Карточки = Новый Массив;
	Для Каждого Ид Из Идентификаторы Цикл
		Стр = Список.НайтиПоИдентификатору(Ид);
		Если Стр <> Неопределено Тогда
			Карточки.Добавить(Стр.Карточка);
		КонецЕсли;
	КонецЦикла;
	ИнвДатыСервер.ПодтвердитьПотери(Карточки, "Подтверждено из отчета");
	ЗаполнитьНаСервере();
КонецПроцедуры
