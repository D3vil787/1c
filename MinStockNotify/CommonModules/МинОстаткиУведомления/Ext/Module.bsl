// ============================================================================
// Общий модуль расширения: МинОстаткиУведомления
// Свойства модуля: Сервер = Истина
//
// Назначение: каждое утро (регламентное задание) определяет, какую номенклатуру нужно
// заказать поставщику, и отправляет список в Telegram и/или на почту.
//
// Доступно = остаток на местах хранения (с вложенными) + остаток аналогов (если у позиции
//            включено "В расчет потребностей включать аналоги") + заказанное поставщикам
//            и еще не полученное.
// В список попадает позиция, у которой Доступно < Минимальный остаток.
// Нужно заказать = Минимальный остаток - Доступно.
// Каждое утро показывается все, что еще не покрыто заказами (без хранения состояния).
//
// Остатки: регистр накопления "Остатки" (измерение "Номенклатура" - номенклатура или карточка,
// для карточки берется владелец). Заказанное: регистр "Заказы поставщикам" (проведенные
// документы "Заказ поставщику", не закрытые и не помеченные на удаление).
// Аналоги: остальная номенклатура того же вида номенклатуры.
// ============================================================================

#Область ПрограммныйИнтерфейс

// Точка входа регламентного задания.
Процедура ВыполнитьПроверкуМинимальныхОстатков() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Настройки = ПолучитьНастройки();

	Попытка
		ТаблицаПозиций = ПозицииДостигшиеМинимума(Настройки);
	Исключение
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
			"Не удалось рассчитать остатки: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если ТаблицаПозиций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ОтправитьУведомление(ТаблицаПозиций, Настройки) Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Информация,
			"Поставлено в очередь уведомление о необходимости заказа, позиций: " + ТаблицаПозиций.Количество());
	КонецЕсли;

КонецПроцедуры

// Пробный расчет без отправки.
// Вызов из консоли кода на сервере: Сообщить(МинОстаткиУведомления.ТестовыйЗапуск());
//
// Возвращаемое значение:
//  Строка - текст, который был бы отправлен, либо пояснение.
Функция ТестовыйЗапуск() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Настройки = ПолучитьНастройки();
	ТаблицаПозиций = ПозицииДостигшиеМинимума(Настройки);
	Если ТаблицаПозиций.Количество() = 0 Тогда
		Возврат "Заказывать нечего: все позиции покрыты остатком и заказами.";
	КонецЕсли;
	Возврат ТекстСообщения(ТаблицаПозиций, Настройки, Ложь);

КонецФункции

// Устанавливает расписание регламентного задания: ежедневно в 08:00 (время сервера 1С).
// Однократный вызов после загрузки расширения (или задайте расписание вручную в
// "Администрирование - Регламентные и фоновые задания").
Процедура НастроитьРасписание() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Расписание = Новый РасписаниеРегламентногоЗадания;
	Расписание.ВремяНачала = Дата(1, 1, 1, 8, 0, 0);
	Расписание.ПериодПовтораДней = 1;
	Расписание.ПериодПовтораВТечениеДня = 0;

	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.МинОстаткиУведомленияРегл);
	Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор) Цикл
		Задание.Расписание = Расписание;
		Задание.Использование = Истина;
		Задание.Записать();
	КонецЦикла;

КонецПроцедуры

// Данные для отчета "Минимальные остатки": позиции с заданным минимумом (все или только те, что нужно заказать).
// Колонки: Номенклатура, Наименование, ВидНаименование, МинимальныйОстаток, Собственный, Аналоги, Заказано,
// Итого (доступно с заказами), Нужно (сколько заказать), Срок (ближайшая ожидаемая дата поступления
// или Неопределено), ВключатьАналоги, Достигнут.
Функция ПозицииДляОтчета(ТолькоДостигшие = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат ПозицииДостигшиеМинимума(ПолучитьНастройки(), Не ТолькоДостигшие);

КонецФункции

// Наименования корневых мест хранения, по которым считается остаток (для шапки отчета).
Функция МестаХраненияДляОтчета() Экспорт

	Возврат ПолучитьНастройки().КорневыеМестаХранения;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройки уведомлений. Меняются правкой этой функции.
Функция ПолучитьНастройки()

	Результат = Новый Структура;
	// Наименования мест хранения через запятую, остатки которых учитываются (вместе с вложенными).
	Результат.Вставить("КорневыеМестаХранения", "!Коммутационная,!Основная серверная,!ИТ отдел");

	// Канал Telegram. Пустой КодЧатаTelegram - канал выключен.
	// КодЧатаTelegram - код элемента справочника "Telegram пользователи" (идентификатор общего чата,
	// для групп отрицательный). ИмяБота - наименование бота; пусто - первый активный бот.
	Результат.Вставить("КодЧатаTelegram", "");
	Результат.Вставить("ИмяБота", "");

	// Канал почты. Пустой ПочтаПолучатели - канал выключен.
	// ПочтаПолучатели - адреса через ";". ПочтаУчетнаяЗапись - наименование учетной записи электронной почты
	// (справочник "Учетные записи электронной почты"); пусто - системная учетная запись.
	Результат.Вставить("ПочтаПолучатели", "");
	Результат.Вставить("ПочтаУчетнаяЗапись", "Уведомления ИТ");

	Возврат Результат;

КонецФункции

// Возвращает таблицу позиций номенклатуры с заданным минимальным остатком.
// ВсеПозиции = Ложь - только те, у которых Доступно < Минимума (нужно заказать).
Функция ПозицииДостигшиеМинимума(Настройки, ВсеПозиции = Ложь)

	Места = МестаХраненияДляРасчета(Настройки.КорневыеМестаХранения);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Места", Места);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Номенклатура) = ТИП(Справочник.Номенклатура)
	|			ТОГДА Остатки.Номенклатура
	|		ИНАЧЕ Остатки.Номенклатура.Владелец
	|	КОНЕЦ КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(, МестоХранения В (&Места)) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Номенклатура) = ТИП(Справочник.Номенклатура)
	|			ТОГДА Остатки.Номенклатура
	|		ИНАЧЕ Остатки.Номенклатура.Владелец
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Н.ВидНоменклатуры КАК ВидНоменклатуры,
	|	СУММА(ОстаткиВТ.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ОстаткиПоВидам
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ОстаткиВТ
	|		ПО Н.Ссылка = ОстаткиВТ.Номенклатура
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|СГРУППИРОВАТЬ ПО
	|	Н.ВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заказы.Номенклатура КАК Номенклатура,
	|	СУММА(Заказы.КоличествоОстаток) КАК Количество,
	|	МИНИМУМ(ВЫБОР
	|		КОГДА Заказы.ЗаказПоставщику.ДатаПоступления = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ДАТАВРЕМЯ(3999, 12, 31)
	|		ИНАЧЕ Заказы.ЗаказПоставщику.ДатаПоступления
	|	КОНЕЦ) КАК Срок
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	РегистрНакопления.ЗаказыПоставщикам.Остатки() КАК Заказы
	|ГДЕ
	|	Заказы.КоличествоОстаток > 0
	|	И НЕ Заказы.ЗаказПоставщику.Закрыт
	|	И НЕ Заказы.ЗаказПоставщику.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Заказы.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Н.ВидНоменклатуры КАК ВидНоменклатуры,
	|	СУММА(ЗаказыВТ.Количество) КАК Количество,
	|	МИНИМУМ(ЗаказыВТ.Срок) КАК Срок
	|ПОМЕСТИТЬ ВТ_ЗаказыПоВидам
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ЗаказыВТ
	|		ПО Н.Ссылка = ЗаказыВТ.Номенклатура
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|СГРУППИРОВАТЬ ПО
	|	Н.ВидНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Наименование КАК Наименование,
	|	Н.ВидНоменклатуры КАК ВидНоменклатуры,
	|	ЕСТЬNULL(Н.ВидНоменклатуры.Наименование, """") КАК ВидНаименование,
	|	Н.МинимальныйОстаток КАК МинимальныйОстаток,
	|	Н.ВРасчетПотребностейВключатьАналоги КАК ВключатьАналоги,
	|	ЕСТЬNULL(ОстаткиВТ.Количество, 0) КАК Собственный,
	|	ЕСТЬNULL(ОстаткиПоВидамВТ.Количество, 0) КАК ПоВиду,
	|	ЕСТЬNULL(ЗаказыВТ.Количество, 0) КАК ЗаказаноСвое,
	|	ЕСТЬNULL(ЗаказыВТ.Срок, ДАТАВРЕМЯ(3999, 12, 31)) КАК СрокСвой,
	|	ЕСТЬNULL(ЗаказыПоВидамВТ.Количество, 0) КАК ЗаказаноПоВиду,
	|	ЕСТЬNULL(ЗаказыПоВидамВТ.Срок, ДАТАВРЕМЯ(3999, 12, 31)) КАК СрокПоВиду
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ОстаткиВТ
	|		ПО Н.Ссылка = ОстаткиВТ.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоВидам КАК ОстаткиПоВидамВТ
	|		ПО Н.ВидНоменклатуры = ОстаткиПоВидамВТ.ВидНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ЗаказыВТ
	|		ПО Н.Ссылка = ЗаказыВТ.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗаказыПоВидам КАК ЗаказыПоВидамВТ
	|		ПО Н.ВидНоменклатуры = ЗаказыПоВидамВТ.ВидНоменклатуры
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.МинимальныйОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидНаименование,
	|	Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("ВидНаименование");
	Таблица.Колонки.Добавить("МинимальныйОстаток");
	Таблица.Колонки.Добавить("Собственный");
	Таблица.Колонки.Добавить("Аналоги");
	Таблица.Колонки.Добавить("Заказано");
	Таблица.Колонки.Добавить("Итого");
	Таблица.Колонки.Добавить("Нужно");
	Таблица.Колонки.Добавить("Срок");
	Таблица.Колонки.Добавить("ВключатьАналоги");
	Таблица.Колонки.Добавить("Достигнут");

	ПустойВид = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	НетСрока = Дата(3999, 12, 31);

	Пока Выборка.Следующий() Цикл

		ЕстьАналоги = Выборка.ВключатьАналоги И Выборка.ВидНоменклатуры <> ПустойВид;

		Аналоги = 0;
		Заказано = Выборка.ЗаказаноСвое;
		Срок = Выборка.СрокСвой;
		Если ЕстьАналоги Тогда
			Аналоги = Выборка.ПоВиду - Выборка.Собственный;
			Заказано = Выборка.ЗаказаноПоВиду;
			Срок = Выборка.СрокПоВиду;
		КонецЕсли;

		Итого = Выборка.Собственный + Аналоги + Заказано;
		Достигнут = (Итого < Выборка.МинимальныйОстаток);

		Если ВсеПозиции Или Достигнут Тогда
			Строка = Таблица.Добавить();
			Строка.Номенклатура = Выборка.Номенклатура;
			Строка.Наименование = Выборка.Наименование;
			Строка.ВидНаименование = Выборка.ВидНаименование;
			Строка.МинимальныйОстаток = Выборка.МинимальныйОстаток;
			Строка.Собственный = Выборка.Собственный;
			Строка.Аналоги = Аналоги;
			Строка.Заказано = Заказано;
			Строка.Итого = Итого;
			Строка.Нужно = Макс(Выборка.МинимальныйОстаток - Итого, 0);
			Строка.Срок = ?(Срок = НетСрока Или Заказано = 0, Неопределено, Срок);
			Строка.ВключатьАналоги = Выборка.ВключатьАналоги;
			Строка.Достигнут = Достигнут;
		КонецЕсли;

	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Находит места хранения верхнего уровня по наименованиям и возвращает их со всеми вложенными.
Функция МестаХраненияДляРасчета(ИменаКорней)

	Имена = Новый Массив;
	Для Каждого Имя Из СтрРазделить(ИменаКорней, ",", Ложь) Цикл
		Имена.Добавить(СокрЛП(Имя));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имена", Имена);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК Ссылка,
	|	МестаХранения.Наименование КАК Наименование
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Наименование В (&Имена)
	|	И НЕ МестаХранения.ПометкаУдаления";
	Корни = Запрос.Выполнить().Выгрузить();

	// Защита от ложных тревог: если корневое место не найдено, расчет не выполняем.
	Для Каждого Имя Из Имена Цикл
		Найдено = Ложь;
		Для Каждого Корень Из Корни Цикл
			Если ВРег(СокрЛП(Корень.Наименование)) = ВРег(Имя) Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Найдено Тогда
			ВызватьИсключение "Не найдено место хранения '" + Имя + "'";
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Корни", Корни.ВыгрузитьКолонку("Ссылка"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МестаХранения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МестаХранения КАК МестаХранения
	|ГДЕ
	|	МестаХранения.Ссылка В ИЕРАРХИИ (&Корни)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Формирует текст сообщения. HTML = Истина - разметка для Telegram, Ложь - простой текст (почта, тест).
Функция ТекстСообщения(Таблица, Настройки, HTML = Истина)

	Жирный1 = ?(HTML, "<b>", "");
	Жирный2 = ?(HTML, "</b>", "");

	Текст = Жирный1 + "Нужно заказать поставщику" + Жирный2 + Символы.ПС
		+ "Места хранения: " + Экранировать(Настройки.КорневыеМестаХранения, HTML) + Символы.ПС
		+ "Дата: " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy") + Символы.ПС;

	ТекущийВид = Неопределено;
	Для Каждого Строка Из Таблица Цикл

		Если Строка.ВидНаименование <> ТекущийВид Тогда
			ТекущийВид = Строка.ВидНаименование;
			Текст = Текст + Символы.ПС + Жирный1
				+ Экранировать(?(ПустаяСтрока(ТекущийВид), "Без вида", ТекущийВид), HTML) + Жирный2 + Символы.ПС;
		КонецЕсли;

		Текст = Текст + "• " + Экранировать(Строка.Наименование, HTML) + ": заказать " + ФорматЧисла(Строка.Нужно)
			+ " (на складе " + ФорматЧисла(Строка.Собственный + Строка.Аналоги);
		Если Строка.ВключатьАналоги И Строка.Аналоги <> 0 Тогда
			Текст = Текст + ", в т.ч. аналоги " + ФорматЧисла(Строка.Аналоги);
		КонецЕсли;
		Если Строка.Заказано <> 0 Тогда
			Текст = Текст + ", уже заказано " + ФорматЧисла(Строка.Заказано);
			Если Строка.Срок <> Неопределено Тогда
				Текст = Текст + " к " + Формат(Строка.Срок, "ДФ=dd.MM.yyyy");
			КонецЕсли;
		КонецЕсли;
		Текст = Текст + ", минимум " + ФорматЧисла(Строка.МинимальныйОстаток) + ")" + Символы.ПС;
		Если Не HTML Тогда
			// В письме (простой текст) Outlook склеивает соседние строки - разделяем позиции пустой строкой.
			Текст = Текст + Символы.ПС;
		КонецЕсли;

	КонецЦикла;

	Возврат Текст;

КонецФункции

// Число без лишних нулей и разделителей групп: 3 вместо 3,000.
Функция ФорматЧисла(Значение)

	Если Значение = Цел(Значение) Тогда
		Возврат Формат(Значение, "ЧДЦ=0; ЧН=0; ЧГ=");
	КонецЕсли;
	Возврат Формат(Значение, "ЧДЦ=3; ЧН=0; ЧГ=");

КонецФункции

Функция Экранировать(Знач Строка, HTML)

	Если Не HTML Тогда
		Возврат Строка;
	КонецЕсли;
	Строка = СтрЗаменить(Строка, "&", "&amp;");
	Строка = СтрЗаменить(Строка, "<", "&lt;");
	Строка = СтрЗаменить(Строка, ">", "&gt;");
	Возврат Строка;

КонецФункции

// Тестовая отправка письма (вызывать вручную): ошибки не скрываются.
Функция ТестоваяОтправкаПочты() Экспорт

	Настройки = ПолучитьНастройки();
	Таблица = ПозицииДостигшиеМинимума(Настройки);
	ОтправитьНаПочту(ТекстСообщения(Таблица, Настройки, Ложь), Таблица.Количество(), Настройки);
	Возврат "Письмо отправлено: " + Настройки.ПочтаПолучатели + " (позиций: " + Таблица.Количество() + ")";

КонецФункции

// Отправляет уведомление во все включенные каналы.
//
// Возвращаемое значение:
//  Булево - Истина, если сработал хотя бы один канал.
Функция ОтправитьУведомление(Таблица, Настройки)

	Успех = Ложь;
	ЕстьКанал = Ложь;

	Если Не ПустаяСтрока(Настройки.КодЧатаTelegram) Тогда
		ЕстьКанал = Истина;
		Попытка
			ПоставитьВОчередьTelegram(ТекстСообщения(Таблица, Настройки, Истина), Настройки);
			Успех = Истина;
		Исключение
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
				"Не удалось поставить сообщение в очередь Telegram: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если Не ПустаяСтрока(Настройки.ПочтаПолучатели) Тогда
		ЕстьКанал = Истина;
		Попытка
			ОтправитьНаПочту(ТекстСообщения(Таблица, Настройки, Ложь), Таблица.Количество(), Настройки);
			Успех = Истина;
		Исключение
			ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
				"Не удалось отправить письмо: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если Не ЕстьКанал Тогда
		ЗаписатьВЖурнал(УровеньЖурналаРегистрации.Ошибка,
			"Не включен ни один канал уведомлений (задайте КодЧатаTelegram и/или ПочтаПолучатели в ПолучитьНастройки())");
	КонецЕсли;

	Возврат Успех;

КонецФункции

// Отправляет письмо через стандартную подсистему работы с почтой.
Процедура ОтправитьНаПочту(Текст, КоличествоПозиций, Настройки)

	УчетнаяЗапись = Неопределено;
	Если ПустаяСтрока(Настройки.ПочтаУчетнаяЗапись) Тогда
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	Иначе
		УчетнаяЗапись = Справочники.УчетныеЗаписиЭлектроннойПочты.НайтиПоНаименованию(Настройки.ПочтаУчетнаяЗапись, Истина);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		ВызватьИсключение "Не найдена учетная запись электронной почты";
	КонецЕсли;

	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Кому", Настройки.ПочтаПолучатели);
	ПараметрыПисьма.Вставить("Тема", "Нужно заказать поставщику (позиций: " + КоличествоПозиций + ")");
	ПараметрыПисьма.Вставить("Тело", Текст);

	Письмо = РаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
	РаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);

КонецПроцедуры

// Создает исходящее сообщение подсистемы Telegram. Отправку выполняет штатное
// регламентное задание "Telegram отправка исходящих сообщений" (учитывает прокси).
Процедура ПоставитьВОчередьTelegram(Текст, Настройки)

	Если ПустаяСтрока(Настройки.КодЧатаTelegram) Тогда
		ВызватьИсключение "Не задан код чата Telegram (ПолучитьНастройки().КодЧатаTelegram)";
	КонецЕсли;

	Получатель = Справочники.TelegramПользователи.НайтиПоКоду(СокрЛП(Настройки.КодЧатаTelegram));
	Если Получатель.Пустая() Тогда
		ВызватьИсключение "В справочнике 'Telegram пользователи' нет элемента с кодом " + Настройки.КодЧатаTelegram;
	КонецЕсли;

	Бот = НайтиБота(Настройки.ИмяБота);

	Сообщение = Документы.TelegramСообщениеИсходящее.СоздатьДокумент();
	Сообщение.Дата = ТекущаяДатаСеанса();
	Сообщение.Бот = Бот;
	Сообщение.Текст = Текст;
	СтрокаАдресата = Сообщение.Адресаты.Добавить();
	СтрокаАдресата.Адресат = Получатель;
	СтрокаАдресата.Состояние = Перечисления.TelegramСостояниеИсходящегоСообщения.Исходящее;
	Сообщение.Записать();

КонецПроцедуры

Функция НайтиБота(ИмяБота)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяБота", ИмяБота);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	TelegramБоты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.TelegramБоты КАК TelegramБоты
	|ГДЕ
	|	TelegramБоты.Активность
	|	И НЕ TelegramБоты.ПометкаУдаления
	|	И (&ИмяБота = """" ИЛИ TelegramБоты.Наименование = &ИмяБота)
	|
	|УПОРЯДОЧИТЬ ПО
	|	TelegramБоты.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Не найден активный бот Telegram";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Процедура ЗаписатьВЖурнал(Уровень, Комментарий)

	ЗаписьЖурналаРегистрации("МинОстаткиУведомления", Уровень, , , Комментарий);

КонецПроцедуры

#КонецОбласти
