&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьТест(Команда)
	ПоказатьПредупреждение(, ОтправитьТестНаСервере());
КонецПроцедуры

&НаСервере
Функция ОтправитьТестНаСервере()
	Попытка
		Возврат МинОстаткиУведомления.ТестоваяОтправкаПочты();
	Исключение
		Возврат "Ошибка отправки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ВключитьРасписание(Команда)
	ПоказатьПредупреждение(, ВключитьРасписаниеНаСервере());
КонецПроцедуры

&НаСервере
Функция ВключитьРасписаниеНаСервере()
	Попытка
		МинОстаткиУведомления.НастроитьРасписание();
		Возврат "Ежедневная отправка включена: каждый день в 08:00 (время сервера 1С).";
	Исключение
		Возврат "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура РезультатВыбор(Элемент, Область, СтандартнаяОбработка)
	Если ТипЗнч(Область.Расшифровка) = Тип("СправочникСсылка.Номенклатура") Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, Область.Расшифровка);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Таблица = МинОстаткиУведомления.ПозицииДляОтчета(ТолькоДостигшие);

	Результат.Очистить();
	Стр = 1;

	Результат.Область(Стр, 1, Стр, 1).Текст = "Минимальные остатки номенклатуры на " + Формат(ТекущаяДатаСеанса(), "ДФ='dd.MM.yyyy HH:mm'");
	Результат.Область(Стр, 1, Стр, 1).Шрифт = Новый Шрифт(Результат.Область(Стр, 1, Стр, 1).Шрифт, , 12, Истина);
	Стр = Стр + 1;
	Результат.Область(Стр, 1, Стр, 1).Текст = "Места хранения (с вложенными): " + МинОстаткиУведомления.МестаХраненияДляОтчета();
	Стр = Стр + 1;
	Результат.Область(Стр, 1, Стр, 1).Текст = "Всего = свой остаток + остаток других номенклатур того же вида (если у позиции включено ""В расчет потребностей включать аналоги"") + заказано поставщикам и еще не получено";
	Стр = Стр + 1;
	Результат.Область(Стр, 1, Стр, 1).Текст = "Нужно заказать = Минимум - Всего. Позиция попадает в уведомление, если Всего меньше минимума.";
	Стр = Стр + 2;

	Заголовки = Новый Массив;
	Заголовки.Добавить("Вид номенклатуры");
	Заголовки.Добавить("Номенклатура");
	Заголовки.Добавить("Минимум");
	Заголовки.Добавить("Свой остаток");
	Заголовки.Добавить("Остаток аналогов");
	Заголовки.Добавить("В заказах");
	Заголовки.Добавить("Всего");
	Заголовки.Добавить("Нужно заказать");
	Заголовки.Добавить("Ожидается к");
	Заголовки.Добавить("Аналоги включены");
	Заголовки.Добавить("Статус");

	Для Колонка = 1 По Заголовки.Количество() Цикл
		Ячейка = Результат.Область(Стр, Колонка, Стр, Колонка);
		Ячейка.Текст = Заголовки[Колонка - 1];
		Ячейка.Шрифт = Новый Шрифт(Ячейка.Шрифт, , , Истина);
		Ячейка.ЦветФона = Новый Цвет(220, 220, 220);
	КонецЦикла;
	Результат.ФиксацияСверху = Стр;
	Стр = Стр + 1;

	Формат_Числа = "ЧДЦ=; ЧН=0; ЧГ=";
	Заказать = 0;
	Для Каждого Строка Из Таблица Цикл

		Результат.Область(Стр, 1, Стр, 1).Текст = ?(ПустаяСтрока(Строка.ВидНаименование), "Без вида", Строка.ВидНаименование);
		Результат.Область(Стр, 2, Стр, 2).Текст = Строка.Наименование;
		Результат.Область(Стр, 2, Стр, 2).Расшифровка = Строка.Номенклатура;
		Результат.Область(Стр, 3, Стр, 3).Текст = Формат(Строка.МинимальныйОстаток, Формат_Числа);
		Результат.Область(Стр, 4, Стр, 4).Текст = Формат(Строка.Собственный, Формат_Числа);
		Результат.Область(Стр, 5, Стр, 5).Текст = Формат(Строка.Аналоги, Формат_Числа);
		Результат.Область(Стр, 6, Стр, 6).Текст = Формат(Строка.Заказано, Формат_Числа);
		Результат.Область(Стр, 7, Стр, 7).Текст = Формат(Строка.Итого, Формат_Числа);
		Результат.Область(Стр, 8, Стр, 8).Текст = Формат(Строка.Нужно, Формат_Числа);
		Результат.Область(Стр, 9, Стр, 9).Текст = ?(Строка.Срок = Неопределено, "", Формат(Строка.Срок, "ДФ=dd.MM.yyyy"));
		Результат.Область(Стр, 10, Стр, 10).Текст = ?(Строка.ВключатьАналоги, "да", "нет");
		Результат.Область(Стр, 11, Стр, 11).Текст = ?(Строка.Достигнут, "ЗАКАЗАТЬ", "в норме");

		Если Строка.Достигнут Тогда
			Заказать = Заказать + 1;
			Результат.Область(Стр, 1, Стр, 11).ЦветФона = Новый Цвет(255, 220, 220);
		КонецЕсли;

		Стр = Стр + 1;

	КонецЦикла;

	Стр = Стр + 1;
	Результат.Область(Стр, 1, Стр, 1).Текст = "Позиций в отчете: " + Таблица.Количество() + ", нужно заказать: " + Заказать;

	Ширины = Новый Массив;
	Ширины.Добавить(40);
	Ширины.Добавить(48);
	Ширины.Добавить(10);
	Ширины.Добавить(13);
	Ширины.Добавить(16);
	Ширины.Добавить(11);
	Ширины.Добавить(10);
	Ширины.Добавить(15);
	Ширины.Добавить(13);
	Ширины.Добавить(17);
	Ширины.Добавить(14);
	Для Колонка = 1 По Ширины.Количество() Цикл
		Результат.Область(1, Колонка, 1, Колонка).ШиринаКолонки = Ширины[Колонка - 1];
	КонецЦикла;

КонецПроцедуры
